{
  "$schema": "./theme.schema.json",
  "id": "moonlight",
  "name": "Moonlight",
  "author": "atomiks, port by CabinetOS",
  "attribution": "Colours from Moonlight by atomiks (https://github.com/atomiks/moonlight-vscode-theme), used under the MIT License.",
  "version": "1.0.0",
  "kind": "dark",
  "accent": "#7CAFFF",
  "mica": {
    "tint": "#1E2030",
    "opacity": 0.9
  },
  "palette": {
    "textPrimary": "#C8D3F5",
    "textSecondary": "#C8D3F5E6",
    "textTertiary": "#A9B8E8",
    "textDisabled": "#444A73",
    "layerFill": "#2F334D80",
