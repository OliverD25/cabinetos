    "ansi": [
      "#000000",
      "#FF628C",
      "#3AD900",
      "#FFC600",
      "#0088FF",
      "#FB94FF",
      "#80FCFF",
      "#FFFFFF",
      "#0050A4",
      "#FF628C",
      "#3AD900",
      "#FFC600",
      "#0088FF",
      "#FB94FF",
      "#80FCFF",
      "#FFFFFF"
    ]
  }
