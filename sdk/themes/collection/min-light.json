    "ansi": [
      "#333333",
      "#D32F2F",
      "#77CC00",
      "#F29718",
      "#6871FF",
      "#9966CC",
      "#4DBF99",
      "#C7C7C7",
      "#A1A1A1",
      "#D6656A",
      "#A3D900",
      "#E7C547",
      "#6871FF",
      "#A37ACC",
      "#57D9AD",
      "#7E7E7E"
    ]
  }
}
