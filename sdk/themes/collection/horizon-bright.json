    "ansi": [
      "#000000",
      "#E95678",
      "#29D398",
      "#FAB795",
      "#26BBD9",
      "#EE64AC",
      "#59E1E3",
      "#555555",
      "#666666",
      "#EC6A88",
      "#3FDAA4",
      "#FBC3A7",
      "#3FC4DE",
      "#F075B5",
      "#6BE4E6",
      "#A5A5A5"
    ]
  }
