{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventEnvelope",
  "description": "One message on the control channel: a request ID plus the message body.\n\nOn the wire the body's fields sit next to `id` in one flat JSON object:\n\n```json\n{\"id\":\"01J9ZQ4X7K3M5N8P2R6S0T1V4W\",\"type\":\"ping\"}\n{\"id\":\"01J9ZQ4X7K3M5N8P2R6S0T1V4W\",\"type\":\"pong\",\"protocol_version\":3,\"core_version\":\"0.1.0\"}\n```",
  "type": "object",
  "properties": {
    "id": {
      "description": "Created by the sender of a request. The reply carries the same ID. An\nevent carries a fresh ID of its own.",
      "$ref": "#/$defs/RequestId"
    }
  },
  "oneOf": [
    {
      "description": "A watched directory changed, and a new listing is complete in a new\nshared-memory section. The previous section stays valid until the\nclient closes its handle to it.",
      "type": "object",
      "properties": {
        "entry_count": {
          "description": "Entries in the new listing.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "generation": {
          "description": "One more than the previous listing of this `listing_id`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "listing_id": {
          "description": "The listing, from `listing_opened`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reason": {
          "description": "Why the listing was read again.",
          "$ref": "#/$defs/RefreshReason"
        },
        "section_handle": {
          "description": "A handle to the new section, already valid in the client's\nprocess. The client owns it and must close it.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "section_size": {
          "description": "How many bytes of the new section hold the listing.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "listing_refreshed"
        }
      },
      "required": [
        "type",
        "listing_id",
        "section_handle",
        "section_size",
        "entry_count",
        "generation",
        "reason"
      ]
    },
    {
      "description": "A watched listing can no longer be kept current, for example because\nits directory was deleted. No more events follow for it.",
      "type": "object",
      "properties": {
        "listing_id": {
          "description": "The listing, from `listing_opened`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "message": {
          "description": "What happened, for logs and the user.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "listing_lost"
        }
      },
      "required": [
        "type",
        "listing_id",
        "message"
      ]
    },
    {
      "description": "The configuration file changed and the new settings are in effect.\nSent to every connection that said `hello`.",
      "type": "object",
      "properties": {
        "changed": {
          "description": "The settings that changed, as dotted paths such as `ui.layout`,\n`panes.sort` or `keybindings`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type": {
          "type": "string",
          "const": "config_changed"
        }
      },
      "required": [
        "type",
        "changed"
      ]
    },
    {
      "description": "The configuration file changed but cannot be used; the previous\nsettings stay in effect.",
      "type": "object",
      "properties": {
        "column": {
          "description": "The column of the problem, counting from 1, when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "line": {
          "description": "The line of the problem, counting from 1, when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "message": {
          "description": "What is wrong.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "config_error"
        }
      },
      "required": [
        "type",
        "message"
      ]
    },
    {
      "description": "The compiled keymap changed (after `config_changed` for the same\nchange). Sent to every connection that said `hello`.",
      "type": "object",
      "properties": {
        "keymap": {
          "description": "The new keymap.",
          "$ref": "#/$defs/Keymap"
        },
        "type": {
          "type": "string",
          "const": "keymap_changed"
        }
      },
      "required": [
        "type",
        "keymap"
      ]
    },
    {
      "description": "How far a job has come. At most 30 per second per job, and always\none when the job ends. Sent to every connection that said `hello`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "job_progress"
        }
      },
      "$ref": "#/$defs/JobProgress",
      "required": [
        "type"
      ]
    },
    {
      "description": "A file of a job needs a decision (`resolve_conflict`). The file waits;\nthe rest of the job goes on.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "job_conflict"
        }
      },
      "$ref": "#/$defs/Conflict",
      "required": [
        "type"
      ]
    },
    {
      "description": "A job changed state. After a final state (`completed`,\n`completed_with_errors`, `cancelled`, `failed`) no more events follow\nfor that job.",
      "type": "object",
      "properties": {
        "job_id": {
          "description": "The job.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "description": "Its new state.",
          "$ref": "#/$defs/JobState"
        },
        "type": {
          "type": "string",
          "const": "job_state_changed"
        }
      },
      "required": [
        "type",
        "job_id",
        "state"
      ]
    },
    {
      "description": "A plugin changed state. Sent to every connection that said `hello`.",
      "type": "object",
      "properties": {
        "plugin_id": {
          "description": "The plugin.",
          "type": "string"
        },
        "state": {
          "description": "Its new state.",
          "$ref": "#/$defs/PluginState"
        },
        "type": {
          "type": "string",
          "const": "plugin_state_changed"
        }
      },
      "required": [
        "type",
        "plugin_id",
        "state"
      ]
    },
    {
      "description": "A plugin trapped or ran out of time, fuel or memory. Its instance is\ngone and its commands are unregistered; the core goes on.",
      "type": "object",
      "properties": {
        "message": {
          "description": "The trap.",
          "type": "string"
        },
        "plugin_id": {
          "description": "The plugin.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "plugin_crashed"
        }
      },
      "required": [
        "type",
        "plugin_id",
        "message"
      ]
    },
    {
      "description": "An event a plugin sent (capability `events:emit`).",
      "type": "object",
      "properties": {
        "name": {
          "description": "The event's name, chosen by the plugin.",
          "type": "string"
        },
        "payload": {
          "description": "Its payload, as the plugin wrote it (usually JSON).",
          "type": "string"
        },
        "plugin_id": {
          "description": "The plugin.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "plugin_event"
        }
      },
      "required": [
        "type",
        "plugin_id",
        "name",
        "payload"
      ]
    },
    {
      "description": "A terminal session's shell exited. Sent to every connection that said\n`hello`. Its last output is on the byte pipe before it closes.",
      "type": "object",
      "properties": {
        "exit_code": {
          "description": "The shell's exit code.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "session_id": {
          "description": "The session.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "terminal_exited"
        }
      },
      "required": [
        "type",
        "session_id",
        "exit_code"
      ]
    }
  ],
  "required": [
    "id"
  ],
  "$defs": {
    "Conflict": {
      "description": "A file that needs a decision. The file waits; the rest of the job goes on.",
      "type": "object",
      "properties": {
        "conflict_id": {
          "description": "Names the conflict in `resolve_conflict`; unique across all jobs.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "destination": {
          "description": "Where it was going, for a copy or a move.",
          "type": [
            "string",
            "null"
          ]
        },
        "job_id": {
          "description": "The job it belongs to.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "description": "What happened.",
          "$ref": "#/$defs/ConflictKind"
        },
        "source": {
          "description": "The file or folder the job was working on.",
          "type": "string"
        }
      },
      "required": [
        "conflict_id",
        "job_id",
        "kind",
        "source"
      ]
    },
    "ConflictKind": {
      "description": "What stopped a file. Times are FILETIME ticks (100 ns since 1601-01-01\nUTC), as in the listing section.",
      "oneOf": [
        {
          "description": "The destination already has a file of that name.",
          "type": "object",
          "properties": {
            "dest_modified": {
              "description": "Last-write time of the existing file.",
              "type": "integer",
              "format": "int64"
            },
            "dest_size": {
              "description": "Size of the existing file in bytes.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "source_modified": {
              "description": "Last-write time of the source.",
              "type": "integer",
              "format": "int64"
            },
            "source_size": {
              "description": "Size of the source in bytes.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "file_exists"
            }
          },
          "required": [
            "type",
            "source_size",
            "source_modified",
            "dest_size",
            "dest_modified"
          ]
        },
        {
          "description": "Windows denied access, for example to a read-only file.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "access_denied"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Another program has the file open.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "sharing_violation"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "The path is too long for the destination's file system.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "path_too_long"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "The destination disk is full; the job is paused.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "disk_full"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "The source disappeared before it was handled.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "source_vanished"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "The Recycle Bin cannot take the item: it is bigger than the bin, the\nbin is turned off, or the drive has none. Nothing was deleted; only\n`delete_permanently` or `skip` answer this.",
          "type": "object",
          "properties": {
            "size": {
              "description": "The item's size in bytes (a folder's whole contents).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "recycle_bin_too_small"
            }
          },
          "required": [
            "type",
            "size"
          ]
        },
        {
          "description": "Any other error.",
          "type": "object",
          "properties": {
            "code": {
              "description": "The Windows error code.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "message": {
              "description": "Its text.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "io"
            }
          },
          "required": [
            "type",
            "code",
            "message"
          ]
        }
      ]
    },
    "JobProgress": {
      "description": "How far a job has come.",
      "type": "object",
      "properties": {
        "bytes_done": {
          "description": "Bytes copied so far.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "bytes_total": {
          "description": "Bytes to copy in all; 0 for a delete or a move on one volume.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "conflicts_open": {
          "description": "Files waiting for a conflict decision.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "current_path": {
          "description": "The file being worked on now.",
          "type": [
            "string",
            "null"
          ]
        },
        "elapsed_ms": {
          "description": "Milliseconds since the job started working (after `queued`).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "eta_seconds": {
          "description": "Seconds left at the current speed; absent in the first two seconds\nand when there are no bytes to count.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "files_done": {
          "description": "Files and folders handled so far, skipped and failed ones included.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files_failed": {
          "description": "Of `files_done`, the ones that failed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files_skipped": {
          "description": "Of `files_done`, the ones skipped by a conflict decision.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files_total": {
          "description": "Files and folders to handle in all.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "job_id": {
          "description": "The job, from `job_started`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "speed_bps": {
          "description": "Bytes per second, averaged over about the last second.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "description": "Its state.",
          "$ref": "#/$defs/JobState"
        }
      },
      "required": [
        "job_id",
        "state",
        "bytes_done",
        "bytes_total",
        "files_done",
        "files_total",
        "files_skipped",
        "files_failed",
        "conflicts_open",
        "speed_bps",
        "elapsed_ms"
      ]
    },
    "JobState": {
      "description": "Where a job is in its life.",
      "oneOf": [
        {
          "description": "Waiting for its disks: another job is using them.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "queued"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Walking the sources to count the files and bytes.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "scanning"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Working. Files waiting for a conflict decision do not change this.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "running"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Stopped by the user, or by a full disk, until resumed.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "paused"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Done; every file was handled (skipped files count as handled).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "completed"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Done, but some files failed.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "completed_with_errors"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Stopped for good by the user.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Stopped by an error that concerns the whole job.",
          "type": "object",
          "properties": {
            "message": {
              "description": "What went wrong.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "type",
            "message"
          ]
        }
      ]
    },
    "Keymap": {
      "description": "The compiled keymap: every binding in effect. The UI runs the chord state\nmachine with it; the core stays the source of truth.",
      "type": "object",
      "properties": {
        "bindings": {
          "description": "The bindings, grouped by command in registry order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeymapBinding"
          }
        },
        "chord_window_ms": {
          "description": "After the first key of a two-key chord, how long the second may take.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "immutable": {
          "description": "The commands of the Immutable System Tier: their bindings cannot be\nchanged, and no other command may use their keys.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "chord_window_ms",
        "bindings",
        "immutable"
      ]
    },
    "KeymapBinding": {
      "description": "One key binding.",
      "type": "object",
      "properties": {
        "command": {
          "description": "The command the keys run.",
          "type": "string"
        },
        "keys": {
          "description": "Normalized keys, for example `ctrl+shift+p` or `ctrl+k ctrl+s` (a\nchord: two combinations, one after the other). Grammar in\n`docs/keybindings.md`.",
          "type": "string"
        },
        "when": {
          "description": "The context in which the binding applies, for example `filesView`;\nabsent means everywhere.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "keys",
        "command"
      ]
    },
    "PluginState": {
      "description": "Where a plugin is in its life.",
      "oneOf": [
        {
          "description": "Being compiled and started.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "loading"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Running; its commands are registered.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "active"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Turned off in the configuration.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "disabled"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "It asks for capabilities the user has not granted; it does not run\nuntil they are.",
          "type": "object",
          "properties": {
            "missing": {
              "description": "The capabilities still to grant.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "needs_review"
            }
          },
          "required": [
            "type",
            "missing"
          ]
        },
        {
          "description": "It could not start: a bad manifest, a component that does not load,\nor `activate` failed.",
          "type": "object",
          "properties": {
            "message": {
              "description": "Why.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "type",
            "message"
          ]
        },
        {
          "description": "It trapped or ran out of time, fuel or memory; its instance was\ndropped.",
          "type": "object",
          "properties": {
            "at_ms": {
              "description": "When, in milliseconds since 1970-01-01 UTC.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "message": {
              "description": "The trap.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "crashed"
            }
          },
          "required": [
            "type",
            "message",
            "at_ms"
          ]
        }
      ]
    },
    "RefreshReason": {
      "description": "Why a watched listing was read again.",
      "oneOf": [
        {
          "description": "Entries were added, removed, renamed or modified.",
          "type": "string",
          "const": "changed"
        },
        {
          "description": "So many changes happened at once that Windows could not report them\none by one; the directory was read again from scratch.",
          "type": "string",
          "const": "overflow"
        }
      ]
    },
    "RequestId": {
      "description": "A ULID created by the sender of a request and echoed unchanged in the reply.",
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
    }
  }
}
