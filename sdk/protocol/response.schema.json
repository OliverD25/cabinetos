{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResponseEnvelope",
  "description": "One message on the control channel: a request ID plus the message body.\n\nOn the wire the body's fields sit next to `id` in one flat JSON object:\n\n```json\n{\"id\":\"01J9ZQ4X7K3M5N8P2R6S0T1V4W\",\"type\":\"ping\"}\n{\"id\":\"01J9ZQ4X7K3M5N8P2R6S0T1V4W\",\"type\":\"pong\",\"protocol_version\":3,\"core_version\":\"0.1.0\"}\n```",
  "type": "object",
  "properties": {
    "id": {
      "description": "Created by the sender of a request. The reply carries the same ID. An\nevent carries a fresh ID of its own.",
      "$ref": "#/$defs/RequestId"
    }
  },
  "oneOf": [
    {
      "description": "Reply to `ping`.",
      "type": "object",
      "properties": {
        "core_version": {
          "description": "The core's version, for example `0.1.0`.",
          "type": "string"
        },
        "protocol_version": {
          "description": "The protocol version the core speaks (`PROTOCOL_VERSION`, now 3).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "pong"
        }
      },
      "required": [
        "type",
        "protocol_version",
        "core_version"
      ]
    },
    {
      "description": "The request succeeded and returns no data.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ok"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "description": "The request failed.",
      "type": "object",
      "properties": {
        "code": {
          "description": "What kind of failure.",
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "description": "A human-readable explanation, for logs and error dialogs.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ]
    },
    {
      "description": "Reply to `hello`.",
      "type": "object",
      "properties": {
        "core_version": {
          "description": "The core's version, for example `0.1.0`.",
          "type": "string"
        },
        "protocol_version": {
          "description": "The protocol version the core speaks (`PROTOCOL_VERSION`, now 3).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "welcome"
        }
      },
      "required": [
        "type",
        "protocol_version",
        "core_version"
      ]
    },
    {
      "description": "Reply to `list_directory`: the listing is complete in shared memory.",
      "type": "object",
      "properties": {
        "elapsed_us": {
          "description": "Microseconds the core spent reading, sorting and writing it.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "entry_count": {
          "description": "Entries in the listing.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "generation": {
          "description": "1 for the first listing, one more for every refresh.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "listing_id": {
          "description": "Names this listing in `close_listing` and in events.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "section_handle": {
          "description": "A handle to the shared-memory section, already valid in the\nclient's process. The client owns it and must close it.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "section_size": {
          "description": "How many bytes of the section hold the listing (the layout is in\n`docs/ipc.md`).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "listing_opened"
        }
      },
      "required": [
        "type",
        "listing_id",
        "section_handle",
        "section_size",
        "entry_count",
        "generation",
        "elapsed_us"
      ]
    },
    {
      "description": "Reply to `volume_info`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "volume_info"
        }
      },
      "$ref": "#/$defs/VolumeDetails",
      "required": [
        "type"
      ]
    },
    {
      "description": "Reply to `get_config`.",
      "type": "object",
      "properties": {
        "config": {
          "description": "The configuration in effect, with defaults filled in, in the\nfile's own format (see `sdk/config/cabinetos.schema.json`)."
        },
        "path": {
          "description": "The configuration file the core reads.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "config"
        }
      },
      "required": [
        "type",
        "path",
        "config"
      ]
    },
    {
      "description": "Reply to `get_keymap`, `set_keybinding` and `reset_keybinding`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "keymap"
        }
      },
      "$ref": "#/$defs/Keymap",
      "required": [
        "type"
      ]
    },
    {
      "description": "Reply to `list_commands`.",
      "type": "object",
      "properties": {
        "commands": {
          "description": "Every command, in registry order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandInfo"
          }
        },
        "type": {
          "type": "string",
          "const": "commands"
        }
      },
      "required": [
        "type",
        "commands"
      ]
    },
    {
      "description": "Reply to `search_commands`: the best matches first.",
      "type": "object",
      "properties": {
        "hits": {
          "description": "The matching commands with their scores.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SearchHit"
          }
        },
        "type": {
          "type": "string",
          "const": "search_results"
        }
      },
      "required": [
        "type",
        "hits"
      ]
    },
    {
      "description": "Reply to `execute_command` for a command the UI runs: the core does\nnothing and hands it back.",
      "type": "object",
      "properties": {
        "target": {
          "description": "Always `ui` for now.",
          "$ref": "#/$defs/CommandTarget"
        },
        "type": {
          "type": "string",
          "const": "command_routed"
        }
      },
      "required": [
        "type",
        "target"
      ]
    },
    {
      "description": "Reply to `execute_command` for a command the core ran.",
      "type": "object",
      "properties": {
        "result": {
          "description": "What the command returned."
        },
        "type": {
          "type": "string",
          "const": "command_result"
        }
      },
      "required": [
        "type",
        "result"
      ]
    },
    {
      "description": "Reply to `start_job`: the job exists and is queued.",
      "type": "object",
      "properties": {
        "job_id": {
          "description": "Names the job in later requests and events; unique for the life\nof the core.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "job_started"
        }
      },
      "required": [
        "type",
        "job_id"
      ]
    },
    {
      "description": "Reply to `list_jobs`: every job, oldest first.",
      "type": "object",
      "properties": {
        "jobs": {
          "description": "The jobs.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/JobInfo"
          }
        },
        "type": {
          "type": "string",
          "const": "jobs"
        }
      },
      "required": [
        "type",
        "jobs"
      ]
    },
    {
      "description": "Reply to `list_plugins`: every installed plugin, by ID.",
      "type": "object",
      "properties": {
        "plugins": {
          "description": "The plugins.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginInfo"
          }
        },
        "type": {
          "type": "string",
          "const": "plugins"
        }
      },
      "required": [
        "type",
        "plugins"
      ]
    },
    {
      "description": "Reply to `search`: the hits, best first (names that start with the\nquery, then shorter names, then paths in order).",
      "type": "object",
      "properties": {
        "complete": {
          "description": "False when the search could not cover everything: a walk stopped\nat its time or entry limit, or a volume was still being indexed.",
          "type": "boolean"
        },
        "hits": {
          "description": "The hits.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileHit"
          }
        },
        "source": {
          "description": "The indexer's index, or the core's own walk.",
          "$ref": "#/$defs/SearchSource"
        },
        "took_us": {
          "description": "How long the search took, in microseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "file_search_results"
        }
      },
      "required": [
        "type",
        "hits",
        "source",
        "took_us",
        "complete"
      ]
    },
    {
      "description": "Reply to `index_status`.",
      "type": "object",
      "properties": {
        "available": {
          "description": "Whether an indexer answered.",
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "index_status"
        },
        "volumes": {
          "description": "Its volumes; empty without an indexer.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/VolumeStatus"
          }
        }
      },
      "required": [
        "type",
        "available",
        "volumes"
      ]
    },
    {
      "description": "Reply to `terminal_open`: the shell runs.",
      "type": "object",
      "properties": {
        "pid": {
          "description": "The shell's process ID.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pipe": {
          "description": "Its byte pipe: open it to read the shell's output and send it\ninput (one client at a time).",
          "type": "string"
        },
        "session_id": {
          "description": "The new session's ID.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "terminal_opened"
        }
      },
      "required": [
        "type",
        "session_id",
        "pipe",
        "pid"
      ]
    },
    {
      "description": "Reply to `terminal_list`: every session, oldest first.",
      "type": "object",
      "properties": {
        "sessions": {
          "description": "The sessions.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TerminalSession"
          }
        },
        "type": {
          "type": "string",
          "const": "terminal_sessions"
        }
      },
      "required": [
        "type",
        "sessions"
      ]
    }
  ],
  "required": [
    "id"
  ],
  "$defs": {
    "CapabilityInfo": {
      "description": "One capability a plugin asks for.",
      "type": "object",
      "properties": {
        "granted": {
          "description": "Whether the user granted it.",
          "type": "boolean"
        },
        "level": {
          "description": "How much it lets the plugin do.",
          "$ref": "#/$defs/CapabilityLevel"
        },
        "name": {
          "description": "For example `fs:read`.",
          "type": "string"
        },
        "reason": {
          "description": "The plugin's own plain-language reason.",
          "type": "string"
        },
        "roots": {
          "description": "The folders it concerns, for `fs:read` and `fs:write`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "level",
        "granted",
        "reason"
      ]
    },
    "CapabilityLevel": {
      "description": "How much a capability lets a plugin do, as the review dialog colors it.",
      "oneOf": [
        {
          "description": "Little risk: registering commands, reading the settings.",
          "type": "string",
          "const": "low"
        },
        {
          "description": "Access to the user's files.",
          "type": "string",
          "const": "medium"
        },
        {
          "description": "Reaching outside the machine or the user's secrets.",
          "type": "string",
          "const": "high"
        }
      ]
    },
    "CommandInfo": {
      "description": "A command, as the palette shows it.",
      "type": "object",
      "properties": {
        "category": {
          "description": "The palette group, for example `View`.",
          "type": "string"
        },
        "default_keys": {
          "description": "The keys it has by default.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "description": "The command's ID, `category.verbObject`, for example\n`view.toggleDualPane`.",
          "type": "string"
        },
        "immutable": {
          "description": "Whether it belongs to the Immutable System Tier.",
          "type": "boolean"
        },
        "keys": {
          "description": "The keys bound now (after the user's changes).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "description": "Who provides the command.",
          "$ref": "#/$defs/CommandSource"
        },
        "target": {
          "description": "Who runs it.",
          "$ref": "#/$defs/CommandTarget"
        },
        "title": {
          "description": "The human name, for example `Toggle Dual Pane`.",
          "type": "string"
        },
        "when": {
          "description": "The context of its default bindings; absent means everywhere.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "category",
        "title",
        "keys",
        "default_keys",
        "source",
        "target",
        "immutable"
      ]
    },
    "CommandSource": {
      "description": "Who provides a command.",
      "oneOf": [
        {
          "description": "Built into the core.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "core"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Registered by a plugin.",
          "type": "object",
          "properties": {
            "id": {
              "description": "The plugin's ID.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "plugin"
            },
            "name": {
              "description": "The plugin's display name, for the badge on its commands.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "name"
          ]
        }
      ]
    },
    "CommandTarget": {
      "description": "Who runs a command.",
      "oneOf": [
        {
          "description": "The core runs it.",
          "type": "string",
          "const": "core"
        },
        {
          "description": "The UI runs it itself (views, panes, overlays).",
          "type": "string",
          "const": "ui"
        }
      ]
    },
    "DiskIdentity": {
      "description": "A physical disk. Two paths on the same `device_number` share one disk, so\ncopies between them compete for it.",
      "type": "object",
      "properties": {
        "bus_type": {
          "description": "How the disk is attached: `NVMe`, `SATA`, `USB`, `SAS`, `SCSI`, `SD`,\n`RAID`, `Spaces`, `Virtual`, … or `Unknown`.",
          "type": "string"
        },
        "device_number": {
          "description": "The disk's number, as in `\\\\.\\PhysicalDriveN`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "media_type": {
          "description": "`HDD` or `SSD`, derived from the seek penalty; `None` when unknown.",
          "type": [
            "string",
            "null"
          ]
        },
        "seek_penalty": {
          "description": "Whether random access is slow (a spinning disk). `None` when the disk\ndoes not say.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "device_number",
        "bus_type"
      ]
    },
    "ErrorCode": {
      "description": "Why a request failed.",
      "oneOf": [
        {
          "description": "The envelope was valid, but its `type` is not a request this core knows.",
          "type": "string",
          "const": "unknown_request"
        },
        {
          "description": "The frame was not a valid envelope (bad JSON, a missing or malformed\n`id`, fields that do not fit the request type), or the request came\nout of order, such as `list_directory` before `hello`.",
          "type": "string",
          "const": "protocol_error"
        },
        {
          "description": "The frame was longer than the 16 MiB limit. The core closes the\nconnection after this reply, because large data belongs in shared\nmemory.",
          "type": "string",
          "const": "frame_too_large"
        },
        {
          "description": "The core failed while handling a valid request.",
          "type": "string",
          "const": "internal"
        },
        {
          "description": "The path does not exist.",
          "type": "string",
          "const": "not_found"
        },
        {
          "description": "Windows denied access to the path.",
          "type": "string",
          "const": "access_denied"
        },
        {
          "description": "The path is malformed, or it names a file where a directory is needed.",
          "type": "string",
          "const": "invalid_path"
        },
        {
          "description": "No open listing on this connection has that `listing_id`.",
          "type": "string",
          "const": "no_such_listing"
        },
        {
          "description": "Reading from the disk or the network failed.",
          "type": "string",
          "const": "io"
        },
        {
          "description": "No command has that ID.",
          "type": "string",
          "const": "unknown_command"
        },
        {
          "description": "The command exists but the core cannot run it yet (it arrives in a\nlater phase).",
          "type": "string",
          "const": "not_implemented"
        },
        {
          "description": "The keys do not follow the key grammar (`docs/keybindings.md`).",
          "type": "string",
          "const": "invalid_keys"
        },
        {
          "description": "The binding would take keys another command already uses, or make a\nchord's first key also a binding of its own.",
          "type": "string",
          "const": "keybinding_conflict"
        },
        {
          "description": "The change touches the Immutable System Tier: its commands keep their\nbindings, and nobody else may use their keys.",
          "type": "string",
          "const": "immutable_binding"
        },
        {
          "description": "The configuration file cannot be changed now: it has an error the\nuser must fix first, or it cannot be written.",
          "type": "string",
          "const": "config_error"
        },
        {
          "description": "No job has that `job_id`.",
          "type": "string",
          "const": "no_such_job"
        },
        {
          "description": "The job has no waiting conflict with that `conflict_id`.",
          "type": "string",
          "const": "no_such_conflict"
        },
        {
          "description": "The resolution does not fit the conflict, such as\n`delete_permanently` for a file that exists.",
          "type": "string",
          "const": "invalid_resolution"
        },
        {
          "description": "No plugin has that ID.",
          "type": "string",
          "const": "no_such_plugin"
        },
        {
          "description": "A plugin's command failed: the plugin reported an error, crashed, or\nis not running.",
          "type": "string",
          "const": "plugin_error"
        },
        {
          "description": "No terminal session has that `session_id` (or its shell has exited,\nfor a request that needs it running).",
          "type": "string",
          "const": "no_such_session"
        },
        {
          "description": "No terminal profile has that name.",
          "type": "string",
          "const": "unknown_profile"
        },
        {
          "description": "The shell could not be started: its program is not on the `PATH`, the\nfolder does not exist, the session limit is reached, or Windows\nrefused.",
          "type": "string",
          "const": "spawn_failed"
        }
      ]
    },
    "FileHit": {
      "description": "One file or directory a search found.",
      "type": "object",
      "properties": {
        "frn": {
          "description": "Its NTFS file reference number, when known (a 64-bit unsigned\ninteger; it can exceed 2^53).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "description": "File or directory.",
          "$ref": "#/$defs/HitKind"
        },
        "path": {
          "description": "Its full path, such as `C:\\Users\\me\\notes.txt`.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind"
      ]
    },
    "HitKind": {
      "description": "Whether a hit is a file or a directory.",
      "oneOf": [
        {
          "description": "A file (a link to a file included).",
          "type": "string",
          "const": "file"
        },
        {
          "description": "A directory (a junction or a link to a directory included).",
          "type": "string",
          "const": "directory"
        }
      ]
    },
    "IndexState": {
      "description": "Where a volume's index is.",
      "oneOf": [
        {
          "description": "The first index is being built; searches skip the volume.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "building"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "The index is current and follows the change journal.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ready"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "A new index is being built; the previous one answers meanwhile.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rebuilding"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "The volume cannot be indexed.",
          "type": "object",
          "properties": {
            "message": {
              "description": "Why.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "type",
            "message"
          ]
        }
      ]
    },
    "JobInfo": {
      "description": "A job as `list_jobs` describes it: its progress and what it works on.",
      "type": "object",
      "properties": {
        "bytes_done": {
          "description": "Bytes copied so far.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "bytes_total": {
          "description": "Bytes to copy in all; 0 for a delete or a move on one volume.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "conflicts_open": {
          "description": "Files waiting for a conflict decision.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "current_path": {
          "description": "The file being worked on now.",
          "type": [
            "string",
            "null"
          ]
        },
        "destination": {
          "description": "The folder it copies or moves into.",
          "type": [
            "string",
            "null"
          ]
        },
        "elapsed_ms": {
          "description": "Milliseconds since the job started working (after `queued`).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "eta_seconds": {
          "description": "Seconds left at the current speed; absent in the first two seconds\nand when there are no bytes to count.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "files_done": {
          "description": "Files and folders handled so far, skipped and failed ones included.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files_failed": {
          "description": "Of `files_done`, the ones that failed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files_skipped": {
          "description": "Of `files_done`, the ones skipped by a conflict decision.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files_total": {
          "description": "Files and folders to handle in all.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "job_id": {
          "description": "The job, from `job_started`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "description": "Copy, move or delete.",
          "$ref": "#/$defs/JobKind"
        },
        "sources": {
          "description": "The paths the job was started with.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "speed_bps": {
          "description": "Bytes per second, averaged over about the last second.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "description": "Its state.",
          "$ref": "#/$defs/JobState"
        }
      },
      "required": [
        "kind",
        "sources",
        "job_id",
        "state",
        "bytes_done",
        "bytes_total",
        "files_done",
        "files_total",
        "files_skipped",
        "files_failed",
        "conflicts_open",
        "speed_bps",
        "elapsed_ms"
      ]
    },
    "JobKind": {
      "description": "What a job does.",
      "oneOf": [
        {
          "description": "Copy the sources into the destination folder.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "copy"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Move the sources into the destination folder: a rename on the same\nvolume, a copy and then a delete of each source file across volumes.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "move"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Delete the sources.",
          "type": "object",
          "properties": {
            "permanent": {
              "description": "Delete for good. Without it the sources go to the Recycle Bin.",
              "type": "boolean",
              "default": false
            },
            "type": {
              "type": "string",
              "const": "delete"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "JobState": {
      "description": "Where a job is in its life.",
      "oneOf": [
        {
          "description": "Waiting for its disks: another job is using them.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "queued"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Walking the sources to count the files and bytes.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "scanning"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Working. Files waiting for a conflict decision do not change this.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "running"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Stopped by the user, or by a full disk, until resumed.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "paused"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Done; every file was handled (skipped files count as handled).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "completed"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Done, but some files failed.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "completed_with_errors"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Stopped for good by the user.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Stopped by an error that concerns the whole job.",
          "type": "object",
          "properties": {
            "message": {
              "description": "What went wrong.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "type",
            "message"
          ]
        }
      ]
    },
    "Keymap": {
      "description": "The compiled keymap: every binding in effect. The UI runs the chord state\nmachine with it; the core stays the source of truth.",
      "type": "object",
      "properties": {
        "bindings": {
          "description": "The bindings, grouped by command in registry order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeymapBinding"
          }
        },
        "chord_window_ms": {
          "description": "After the first key of a two-key chord, how long the second may take.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "immutable": {
          "description": "The commands of the Immutable System Tier: their bindings cannot be\nchanged, and no other command may use their keys.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "chord_window_ms",
        "bindings",
        "immutable"
      ]
    },
    "KeymapBinding": {
      "description": "One key binding.",
      "type": "object",
      "properties": {
        "command": {
          "description": "The command the keys run.",
          "type": "string"
        },
        "keys": {
          "description": "Normalized keys, for example `ctrl+shift+p` or `ctrl+k ctrl+s` (a\nchord: two combinations, one after the other). Grammar in\n`docs/keybindings.md`.",
          "type": "string"
        },
        "when": {
          "description": "The context in which the binding applies, for example `filesView`;\nabsent means everywhere.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "keys",
        "command"
      ]
    },
    "PluginInfo": {
      "description": "One installed plugin.",
      "type": "object",
      "properties": {
        "author": {
          "description": "Who made it.",
          "type": "string"
        },
        "capabilities": {
          "description": "What it asks to do, for the review dialog.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityInfo"
          }
        },
        "commands": {
          "description": "The IDs of the commands it registered (while it is active).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "description": "What it does, in a sentence or two.",
          "type": "string"
        },
        "id": {
          "description": "The plugin's ID, from its `plugin.json`; also its folder's name.",
          "type": "string"
        },
        "name": {
          "description": "Its display name, shown as a badge on its commands.",
          "type": "string"
        },
        "state": {
          "description": "Where it is in its life.",
          "$ref": "#/$defs/PluginState"
        },
        "version": {
          "description": "Its version.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "author",
        "description",
        "state",
        "capabilities",
        "commands"
      ]
    },
    "PluginState": {
      "description": "Where a plugin is in its life.",
      "oneOf": [
        {
          "description": "Being compiled and started.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "loading"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Running; its commands are registered.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "active"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Turned off in the configuration.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "disabled"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "It asks for capabilities the user has not granted; it does not run\nuntil they are.",
          "type": "object",
          "properties": {
            "missing": {
              "description": "The capabilities still to grant.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "needs_review"
            }
          },
          "required": [
            "type",
            "missing"
          ]
        },
        {
          "description": "It could not start: a bad manifest, a component that does not load,\nor `activate` failed.",
          "type": "object",
          "properties": {
            "message": {
              "description": "Why.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "type",
            "message"
          ]
        },
        {
          "description": "It trapped or ran out of time, fuel or memory; its instance was\ndropped.",
          "type": "object",
          "properties": {
            "at_ms": {
              "description": "When, in milliseconds since 1970-01-01 UTC.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "message": {
              "description": "The trap.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "crashed"
            }
          },
          "required": [
            "type",
            "message",
            "at_ms"
          ]
        }
      ]
    },
    "RequestId": {
      "description": "A ULID created by the sender of a request and echoed unchanged in the reply.",
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
    },
    "SearchHit": {
      "description": "One command matching a palette search.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The command's ID.",
          "type": "string"
        },
        "score": {
          "description": "Higher is better; only the order matters.",
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "id",
        "score"
      ]
    },
    "SearchSource": {
      "description": "Where a search's hits came from.",
      "oneOf": [
        {
          "description": "The indexer's index of whole volumes.",
          "type": "string",
          "const": "index"
        },
        {
          "description": "The core's own bounded walk of one folder tree (no indexer).",
          "type": "string",
          "const": "walk"
        }
      ]
    },
    "TerminalSession": {
      "description": "One terminal session, as `terminal_list` reports it.",
      "type": "object",
      "properties": {
        "attached": {
          "description": "Whether a client is attached to the byte pipe now.",
          "type": "boolean"
        },
        "cols": {
          "description": "Its width in character cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "cwd": {
          "description": "The folder it started in, or was last synced to. The shell may have\nmoved since.",
          "type": "string"
        },
        "pid": {
          "description": "The shell's process ID.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pipe": {
          "description": "The session's byte pipe, such as `\\\\.\\pipe\\cabinetos-term-<token>`.",
          "type": "string"
        },
        "profile": {
          "description": "The profile it was opened with, such as `pwsh`.",
          "type": "string"
        },
        "rows": {
          "description": "Its height in character cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "session_id": {
          "description": "The session's ID, unique while the core runs.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "description": "Whether the shell still runs.",
          "$ref": "#/$defs/TerminalState"
        }
      },
      "required": [
        "session_id",
        "profile",
        "cwd",
        "cols",
        "rows",
        "pid",
        "state",
        "pipe",
        "attached"
      ]
    },
    "TerminalState": {
      "description": "Whether a session's shell still runs.",
      "oneOf": [
        {
          "description": "The shell runs.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "running"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "The shell has exited.",
          "type": "object",
          "properties": {
            "code": {
              "description": "Its exit code (a Windows exit code, such as 3221225786 for a\nconsole closed under it).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "exited"
            }
          },
          "required": [
            "type",
            "code"
          ]
        }
      ]
    },
    "VolumeDetails": {
      "description": "The volume a path lives on, and the physical disk under it.",
      "type": "object",
      "properties": {
        "disk": {
          "description": "The physical disk, when Windows can tell (not for network shares).",
          "anyOf": [
            {
              "$ref": "#/$defs/DiskIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "drive_letter": {
          "description": "The volume's drive letter, if it has one.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1,
          "minLength": 1
        },
        "filesystem": {
          "description": "The file system: `NTFS`, `FAT32`, `exFAT`, `ReFS`, …",
          "type": "string"
        },
        "free_bytes": {
          "description": "Bytes free for the current user (disk quotas taken into account).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "label": {
          "description": "The volume label; may be empty.",
          "type": "string"
        },
        "total_bytes": {
          "description": "The volume's capacity in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "volume_guid_path": {
          "description": "The volume's GUID path, for example `\\\\?\\Volume{…}\\`. Empty when the\nvolume has none, such as a network share.",
          "type": "string"
        }
      },
      "required": [
        "volume_guid_path",
        "filesystem",
        "label",
        "total_bytes",
        "free_bytes"
      ]
    },
    "VolumeStatus": {
      "description": "One volume, as the indexer reports it.",
      "type": "object",
      "properties": {
        "built_in_ms": {
          "description": "How long the last build took, in milliseconds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "entries": {
          "description": "The entries the index holds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "journal_lag": {
          "description": "Change-journal bytes written but not yet applied to the index; 0 when\nit is current.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "letter": {
          "description": "The drive letter.",
          "type": "string",
          "maxLength": 1,
          "minLength": 1
        },
        "state": {
          "description": "Where its index is.",
          "$ref": "#/$defs/IndexState"
        }
      },
      "required": [
        "letter",
        "state",
        "entries"
      ]
    }
  }
}
