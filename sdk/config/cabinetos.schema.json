{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CabinetOS configuration",
  "description": "The whole configuration.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Where editors find the schema of this file. The core writes\n`./cabinetos.schema.json` next to it.",
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "description": "What happens to files: the editor that opens them.",
      "$ref": "#/$defs/FilesConfig",
      "default": {
        "editor": null
      }
    },
    "keybindings": {
      "description": "The user's changes to key bindings. The defaults live in the command\nregistry; list only what differs.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/KeybindingEntry"
      }
    },
    "logging": {
      "description": "Diagnostics.",
      "$ref": "#/$defs/LoggingConfig",
      "default": {
        "level": "info"
      }
    },
    "marketplace": {
      "description": "Where extensions and themes come from.",
      "$ref": "#/$defs/MarketplaceConfig",
      "default": {
        "allowInsecure": false,
        "index": "https://oliverd25.github.io/cabinetos-marketplace/index.json"
      }
    },
    "panes": {
      "description": "The file panes.",
      "$ref": "#/$defs/PanesConfig",
      "default": {
        "selection": "windows",
        "showHidden": false,
        "sort": {
          "descending": false,
          "key": "name"
        }
      }
    },
    "plugins": {
      "description": "Core Plugins, by ID: which run, and what they may do. A plugin that\nis not listed is on, with nothing granted.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PluginSettings"
      },
      "default": {}
    },
    "terminal": {
      "description": "The integrated terminal.",
      "$ref": "#/$defs/TerminalConfig",
      "default": {
        "defaultProfile": "pwsh",
        "profiles": [
          {
            "args": [
              "-NoLogo"
            ],
            "command": "pwsh.exe",
            "name": "pwsh"
          },
          {
            "args": [],
            "command": "cmd.exe",
            "name": "cmd"
          },
          {
            "args": [],
            "command": "wsl.exe",
            "name": "wsl"
          }
        ]
      }
    },
    "ui": {
      "description": "The window.",
      "$ref": "#/$defs/UiConfig",
      "default": {
        "dockSize": {
          "bottom": null,
          "right": null
        },
        "dualPane": true,
        "lastPaths": [],
        "layout": "classic",
        "pinned": [],
        "sidebar": true,
        "theme": "default"
      }
    },
    "version": {
      "description": "The file format version; always 1 for now.",
      "type": "integer",
      "format": "uint32",
      "default": 1,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "$defs": {
    "DockSize": {
      "description": "The Tool Dock's size, in pixels, for each place it can sit. `null`: the\ndesign's size, within the design's limits.",
      "type": "object",
      "properties": {
        "bottom": {
          "description": "Its height when it sits under the panes.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "right": {
          "description": "Its width when it sits beside the panes.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "EditorProgram": {
      "description": "A program that edits a file: the file's path is added as its last\nargument. The program is a full path, or a name found on the PATH, as\nfor a terminal profile; never the current folder.",
      "type": "object",
      "properties": {
        "args": {
          "description": "Its arguments, before the file's path, for example `[\"--wait\"]`.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "command": {
          "description": "The program, for example `notepad++.exe` or\n`C:\\Program Files\\Microsoft VS Code\\Code.exe`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "FilesConfig": {
      "description": "What happens to files.",
      "type": "object",
      "properties": {
        "editor": {
          "description": "The program that edits a file (`file.edit`, F4). `null`: Windows'\nown edit verb for the file's type, else Notepad.",
          "anyOf": [
            {
              "$ref": "#/$defs/EditorProgram"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "KeybindingEntry": {
      "description": "One change to a key binding.",
      "type": "object",
      "properties": {
        "command": {
          "description": "The command's ID, for example `view.toggleSidebar`.",
          "type": "string"
        },
        "keys": {
          "description": "The new keys, for example `ctrl+alt+b` or `ctrl+k ctrl+b`; an empty\nstring removes the command's binding. Grammar: docs/keybindings.md.",
          "$ref": "#/$defs/Keys"
        },
        "when": {
          "description": "The context in which the binding applies, for example `filesView`;\nwithout it the command's own context applies.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "command",
        "keys"
      ]
    },
    "Keys": {
      "description": "One combination (`ctrl+shift+p`) or a chord of two separated by a space (`ctrl+k ctrl+c`); an empty string for none. Modifiers: ctrl, shift, alt, win.",
      "type": "string"
    },
    "Layout": {
      "description": "Window layouts from the design.",
      "oneOf": [
        {
          "description": "Sidebar on the left, terminal at the bottom.",
          "type": "string",
          "const": "classic"
        },
        {
          "description": "Terminal on the right.",
          "type": "string",
          "const": "right"
        },
        {
          "description": "An activity rail instead of the full sidebar.",
          "type": "string",
          "const": "rail"
        }
      ]
    },
    "LogLevel": {
      "description": "Log levels, most detailed first.",
      "oneOf": [
        {
          "description": "Everything.",
          "type": "string",
          "const": "trace"
        },
        {
          "description": "Details for developers.",
          "type": "string",
          "const": "debug"
        },
        {
          "description": "Normal operation.",
          "type": "string",
          "const": "info"
        },
        {
          "description": "Problems the core recovered from.",
          "type": "string",
          "const": "warn"
        },
        {
          "description": "Failures.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "LoggingConfig": {
      "description": "Diagnostics.",
      "type": "object",
      "properties": {
        "level": {
          "description": "The least important level written to the log. The environment\nvariable `CABINETOS_LOG` overrides it.",
          "$ref": "#/$defs/LogLevel",
          "default": "info"
        }
      },
      "additionalProperties": false
    },
    "MarketplaceConfig": {
      "description": "The marketplace (docs/marketplace.md).",
      "type": "object",
      "properties": {
        "allowInsecure": {
          "description": "Also accept a plain `http:` index and downloads, which anyone on the\nnetwork could change on the way. For testing only.",
          "type": "boolean",
          "default": false
        },
        "index": {
          "description": "Where the index is: an `https:` URL, a `file:` URL, or the path of an\n`index.json` or of its folder. The core reads it only when a client\nasks.",
          "type": "string",
          "default": "https://oliverd25.github.io/cabinetos-marketplace/index.json"
        }
      },
      "additionalProperties": false
    },
    "PanesConfig": {
      "description": "The file panes. These are the defaults for `list_directory` requests that\ndo not say otherwise.",
      "type": "object",
      "properties": {
        "selection": {
          "description": "How the keyboard marks rows: as Windows does, or as Total Commander\ndoes.",
          "$ref": "#/$defs/SelectionMode",
          "default": "windows"
        },
        "showHidden": {
          "description": "Also list hidden and system entries.",
          "type": "boolean",
          "default": false
        },
        "sort": {
          "description": "The order of entries; directories always come first.",
          "$ref": "#/$defs/SortConfig",
          "default": {
            "descending": false,
            "key": "name"
          }
        }
      },
      "additionalProperties": false
    },
    "PluginSettings": {
      "description": "One plugin's settings.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Run the plugin.",
          "type": "boolean",
          "default": true
        },
        "granted": {
          "description": "The capabilities the user granted it, for example `fs:read`. It runs\nonly when it has every capability it asks for (docs/plugins.md).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "SelectionMode": {
      "description": "How the keyboard marks rows in a file pane (`docs/config.md`).",
      "oneOf": [
        {
          "description": "As in Explorer: a key that moves the cursor selects the row it moves\nto, and Shift extends the selection.",
          "type": "string",
          "const": "windows"
        },
        {
          "description": "As in Total Commander: keys that move the cursor keep the marks,\nShift with them marks the rows passed over, and commands act on the\nmarked rows, or on the cursor row when none is marked.",
          "type": "string",
          "const": "commander"
        }
      ]
    },
    "SortConfig": {
      "description": "The order of a listing.",
      "type": "object",
      "properties": {
        "descending": {
          "description": "Largest, newest or last first.",
          "type": "boolean",
          "default": false
        },
        "key": {
          "description": "`name` (natural order), `size`, `modified` or `kind`.",
          "$ref": "#/$defs/SortKey",
          "default": "name"
        }
      },
      "additionalProperties": false
    },
    "SortKey": {
      "description": "What a listing is sorted by.",
      "oneOf": [
        {
          "description": "Natural order, as in Explorer: case-insensitive, with numbers compared\nby value, so `file2` comes before `file10`.",
          "type": "string",
          "const": "name"
        },
        {
          "description": "File size, then name.",
          "type": "string",
          "const": "size"
        },
        {
          "description": "Last-write time, then name.",
          "type": "string",
          "const": "modified"
        },
        {
          "description": "Entry kind (directory, file, link), then name.",
          "type": "string",
          "const": "kind"
        },
        {
          "description": "Files by extension (the part after the last dot), ignoring case, then\nby name; files without one first. Directories by name.",
          "type": "string",
          "const": "extension"
        }
      ]
    },
    "TerminalConfig": {
      "description": "The integrated terminal (Phase 8).",
      "type": "object",
      "properties": {
        "defaultProfile": {
          "description": "The `name` of the profile a new terminal starts with.",
          "type": "string",
          "default": "pwsh"
        },
        "profiles": {
          "description": "The shells a terminal can run.",
          "type": "array",
          "default": [
            {
              "args": [
                "-NoLogo"
              ],
              "command": "pwsh.exe",
              "name": "pwsh"
            },
            {
              "args": [],
              "command": "cmd.exe",
              "name": "cmd"
            },
            {
              "args": [],
              "command": "wsl.exe",
              "name": "wsl"
            }
          ],
          "items": {
            "$ref": "#/$defs/TerminalProfile"
          }
        }
      },
      "additionalProperties": false
    },
    "TerminalProfile": {
      "description": "One shell a terminal can run.",
      "type": "object",
      "properties": {
        "args": {
          "description": "Its arguments.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "command": {
          "description": "The program, for example `pwsh.exe`.",
          "type": "string"
        },
        "name": {
          "description": "A unique name, for example `pwsh`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "command"
      ]
    },
    "UiConfig": {
      "description": "The window.",
      "type": "object",
      "properties": {
        "dockSize": {
          "description": "The Tool Dock's size as the user last dragged it, so it survives a\nrestart.",
          "$ref": "#/$defs/DockSize",
          "default": {
            "bottom": null,
            "right": null
          }
        },
        "dualPane": {
          "description": "Two file panes side by side, or one.",
          "type": "boolean",
          "default": true
        },
        "lastPaths": {
          "description": "The folders the panes showed last, left pane first, so the next\nstart opens them again. Empty: the UI picks.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "layout": {
          "description": "Where the sidebar, panes and terminal go.",
          "$ref": "#/$defs/Layout",
          "default": "classic"
        },
        "pinned": {
          "description": "Folders the user pinned to the sidebar, in the sidebar's order.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "sidebar": {
          "description": "Show the sidebar.",
          "type": "boolean",
          "default": true
        },
        "theme": {
          "description": "The color theme's ID.",
          "type": "string",
          "default": "default"
        }
      },
      "additionalProperties": false
    }
  }
}
