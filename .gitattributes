# Line endings are fixed per file type so every machine gets the same bytes.
# Text files default to LF. Files that Visual Studio owns use CRLF.
* text=auto eol=lf

# Rust and cross-platform text: LF
*.rs        text eol=lf
*.toml      text eol=lf
*.lock      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.wit       text eol=lf
*.sh        text eol=lf
*.js        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.txt       text eol=lf
.gitattributes text eol=lf
.gitignore  text eol=lf
.editorconfig text eol=lf
LICENSE     text eol=lf

# Windows-owned text: CRLF (Visual Studio and MSBuild expect it)
*.cs        text eol=crlf
*.xaml      text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.slnx      text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.manifest  text eol=crlf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.rc        text eol=crlf
# Inno Setup scripts (build/setup.iss): Inno's own editor writes CRLF.
*.iss       text eol=crlf

# Binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
# Media fixtures of the live check (ui/livecheck/fixtures/media)
*.mp4   binary
*.m4v   binary
*.mov   binary
*.mkv   binary
*.webm  binary
*.mp3   binary
*.m4a   binary
*.aac   binary
*.flac  binary
*.wav   binary
*.ogg   binary
*.opus  binary
*.weba  binary
*.wasm  binary
*.pdf   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.dll   binary
*.exe   binary
*.msix  binary
