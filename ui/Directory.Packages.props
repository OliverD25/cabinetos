<Project>
  <!-- One place for every package version (docs/dev-setup.md, "Phase 5"). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Windows App SDK 2.5.1 as the components the window uses, not the Microsoft.WindowsAppSDK
         metapackage, which also brings the AI, ML, Search, Widgets and DWriteCore components
         (about 40 MB, onnxruntime and DirectML among them; Article 10). The versions are the
         metapackage's: the Runtime package's build checks that they match it. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.335" />
    <!-- Runs on Microsoft.Testing.Platform; ui/global.json turns that mode on for dotnet test. -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <!-- 8.0.5 is the last MIT release; 9.0 moved to a maintenance-fee EULA. -->
    <PackageVersion Include="JsonSchema.Net" Version="8.0.5" />
  </ItemGroup>
</Project>
