<Project>
  <!-- Shared by every project in ui/. Windows 11 22H2 is the floor (ADR 0004);
       x64 only until ARM64 hardware exists to test on (PLAN.md section 2). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <!-- A project built on its own gets the same output folder as in the solution. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.1</Version>
    <Product>CabinetOS</Product>
    <Copyright>Copyright (c) 2026 the CabinetOS authors. MIT license.</Copyright>
  </PropertyGroup>
</Project>
