<Project Sdk="Microsoft.NET.Sdk">
  <!-- CabinetOS.exe: the window. It draws pixels and captures keystrokes;
       everything else happens in cabinetos-core.exe (brief §1). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CabinetOS</RootNamespace>
    <AssemblyName>CabinetOS</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The icon of CabinetOS.exe itself (taskbar, Explorer, Alt+Tab). Made by
         build\make-icon.ps1 from the design's size cuts, committed. -->
    <ApplicationIcon>Assets\CabinetOS.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, so dotnet run works without MSIX; the Windows App Runtime
         2.5 is used from the machine (docs/dev-setup.md, "Phase 5"). The MSIX
         tooling stays on for its resource step alone: without it a publish has
         no CabinetOS.pri, the compiled XAML, and the published window stops at
         start ("Cannot locate resource from 'ms-appx:///MainWindow.xaml'"). -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.Main names the UI thread and starts diagnostics before WinUI. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinUI 3 (and WebView2 through it); Foundation: the bootstrapper of an unpackaged app and
         MRT resources; InteractiveExperiences: windowing, input, composition and Mica; Runtime:
         the Windows App Runtime version the bootstrapper asks for. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CabinetOS.Core\CabinetOS.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The terminal page and xterm.js, served to WebView2 from next to the
         program, never from a CDN (docs/ui.md, "The terminal"). -->
    <Content Include="Assets\xterm\**\*" Exclude="Assets\xterm\README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
