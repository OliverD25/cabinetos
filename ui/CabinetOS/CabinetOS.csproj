<Project Sdk="Microsoft.NET.Sdk">
  <!-- CabinetOS.exe: the window. It draws pixels and captures keystrokes;
       everything else happens in cabinetos-core.exe (brief §1). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CabinetOS</RootNamespace>
    <AssemblyName>CabinetOS</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, so dotnet run works without MSIX; the Windows App Runtime
         2.5 is used from the machine (docs/dev-setup.md, "Phase 5"). -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- Program.Main names the UI thread and starts diagnostics before WinUI. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CabinetOS.Core\CabinetOS.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The terminal page and xterm.js, served to WebView2 from next to the
         program, never from a CDN (docs/ui.md, "The terminal"). -->
    <Content Include="Assets\xterm\**\*" Exclude="Assets\xterm\README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
