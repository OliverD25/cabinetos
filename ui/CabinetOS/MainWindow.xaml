<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CabinetOS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CabinetOS.Views"
    Title="CabinetOS">
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid x:Name="ShellContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- Title bar (40 px): app tile, name, workspace tabs; Windows draws the caption buttons. -->
            <Grid x:Name="TitleBar" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Padding="14,0,4,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Border
                        Width="18"
                        Height="18"
                        CornerRadius="5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="{ThemeResource SystemAccentColorLight2}" />
                                <GradientStop Offset="1" Color="#FF8A5CF6" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource CbTextSecondaryBrush}"
                        Text="CabinetOS" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Padding="6,0,0,0"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="2">
                    <!-- Workspaces arrive in a later phase; one static tab until then. -->
                    <Border
                        Height="32"
                        MinWidth="96"
                        Padding="14,0"
                        Background="{ThemeResource CbTabActiveFillBrush}"
                        CornerRadius="8,8,0,0">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Fill="{ThemeResource CbAccentBrush}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource CbTextPrimaryBrush}"
                                Text="Default" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Command bar (48 px). -->
            <Grid
                Grid.Row="1"
                Padding="10,0"
                ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BackButton"
                    AutomationProperties.Name="Back"
                    Style="{StaticResource CbSubtleButtonStyle}"
                    ToolTipService.ToolTip="Back (Alt+Left)">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <Button
                    x:Name="ForwardButton"
                    Grid.Column="1"
                    AutomationProperties.Name="Forward"
                    Style="{StaticResource CbSubtleButtonStyle}"
                    ToolTipService.ToolTip="Forward (Alt+Right)">
                    <FontIcon FontSize="14" Glyph="&#xE72A;" />
                </Button>
                <Button
                    x:Name="UpButton"
                    Grid.Column="2"
                    AutomationProperties.Name="Up"
                    Style="{StaticResource CbSubtleButtonStyle}"
                    ToolTipService.ToolTip="Up (Backspace)">
                    <FontIcon FontSize="14" Glyph="&#xE74A;" />
                </Button>

                <Grid
                    x:Name="AddressBar"
                    Grid.Column="3"
                    Height="32"
                    Margin="6,0">
                    <Border
                        x:Name="CrumbBar"
                        Padding="4,0,6,0"
                        Background="{ThemeResource CbControlFillBrush}"
                        BorderBrush="{StaticResource CbFieldStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ScrollViewer
                            x:Name="CrumbScroller"
                            HorizontalScrollBarVisibility="Hidden"
                            HorizontalScrollMode="Enabled"
                            IsTabStop="False"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel
                                x:Name="Crumbs"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="2" />
                        </ScrollViewer>
                    </Border>
                    <TextBox
                        x:Name="AddressEdit"
                        AutomationProperties.Name="Address"
                        FontSize="13"
                        Visibility="Collapsed" />
                </Grid>

                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="4"
                    Height="32"
                    AutomationProperties.Name="Search (arrives in a later version)"
                    IsEnabled="False">
                    <TextBox.Resources>
                        <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="CbControlFillBrush" />
                        <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="CbControlStrokeBrush" />
                        <StaticResource x:Key="TextControlPlaceholderForegroundDisabled" ResourceKey="CbTextTertiaryBrush" />
                    </TextBox.Resources>
                </TextBox>

                <Rectangle
                    Grid.Column="5"
                    Width="1"
                    Height="20"
                    Margin="6,0"
                    Fill="{ThemeResource CbOverlayStrokeBrush}" />

                <Button
                    x:Name="DualButton"
                    Grid.Column="6"
                    Padding="10,0"
                    AutomationProperties.Name="Toggle dual pane"
                    Style="{StaticResource CbSubtleButtonStyle}"
                    ToolTipService.ToolTip="Toggle dual pane (Ctrl+Shift+D)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            x:Name="DualIcon"
                            FontSize="14"
                            Glyph="&#xE89A;" />
                        <TextBlock
                            x:Name="DualLabel"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="Dual" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="TerminalButton"
                    Grid.Column="7"
                    AutomationProperties.Name="Terminal (arrives in a later version)"
                    IsEnabled="False"
                    Style="{StaticResource CbSubtleButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE756;" />
                </Button>
                <Button
                    x:Name="MarketplaceButton"
                    Grid.Column="8"
                    AutomationProperties.Name="Marketplace (arrives in a later version)"
                    IsEnabled="False"
                    Style="{StaticResource CbSubtleButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE719;" />
                </Button>
                <Button
                    x:Name="PaletteButton"
                    Grid.Column="9"
                    AutomationProperties.Name="Command palette"
                    Style="{StaticResource CbSubtleButtonStyle}"
                    ToolTipService.ToolTip="Command palette (Ctrl+Shift+P)">
                    <FontIcon
                        FontSize="14"
                        Glyph="&#xE712;"
                        RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="90" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Button>
            </Grid>

            <!-- Body: sidebar and panes, 8 px gutters. -->
            <Grid
                Grid.Row="2"
                Padding="8,0,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:Sidebar x:Name="SidebarView" Margin="0,0,8,0" />
                <Grid x:Name="PanesGrid" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="RightColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <views:FilePane x:Name="LeftPane" Margin="0,0,4,0" />
                    <views:FilePane
                        x:Name="RightPane"
                        Grid.Column="1"
                        Margin="4,0,0,0" />
                </Grid>
            </Grid>

            <!-- Status bar (26 px). -->
            <Border
                Grid.Row="3"
                BorderBrush="{ThemeResource CbDividerBrush}"
                BorderThickness="0,1,0,0">
                <Grid Padding="14,0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ItemsText"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbStatusTextBrush}" />
                    <TextBlock
                        x:Name="SelectionText"
                        Grid.Column="1"
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbStatusTextBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="NoticeText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbStatusTextBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="ChordText"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbAccentBrush}"
                        Visibility="Collapsed" />
                    <TextBlock
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbStatusTextBrush}"
                        Text="UTF-8" />
                    <TextBlock
                        x:Name="LayoutText"
                        Grid.Column="5"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbStatusTextBrush}" />
                    <Button
                        x:Name="PaletteKeycap"
                        Grid.Column="6"
                        Height="18"
                        MinWidth="0"
                        Padding="6,1"
                        AutomationProperties.Name="Command palette"
                        Background="{ThemeResource CbHoverFillBrush}"
                        CornerRadius="3"
                        Style="{StaticResource CbSubtleButtonStyle}">
                        <TextBlock
                            FontFamily="{StaticResource CbMonoFont}"
                            FontSize="11"
                            Foreground="{ThemeResource CbStatusTextBrush}"
                            Text="Ctrl+Shift+P" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <views:CommandPalette x:Name="Palette" Visibility="Collapsed" />
    </Grid>
</Window>
