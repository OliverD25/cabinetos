<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CabinetOS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CabinetOS.Views"
    Title="CabinetOS">
    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- The default look's sizes; the theme's metrics replace them (MainWindow.Metrics.cs). -->
        <Grid x:Name="ShellContent">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="40" />
                <RowDefinition x:Name="CommandRow" Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="StatusRow" Height="26" />
            </Grid.RowDefinitions>

            <!-- Title bar (40 px): app tile, name, workspace tabs; Windows draws the caption buttons. -->
            <Grid x:Name="TitleBar" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Padding="14,0,4,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Border
                        x:Name="AppTile"
                        Width="18"
                        Height="18"
                        Background="{StaticResource CbAppTileBrush}"
                        CornerRadius="5" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource CbTextSecondaryBrush}"
                        Text="CabinetOS" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Padding="6,0,0,0"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="2">
                    <!-- Workspaces arrive in a later phase; one static tab until then. -->
                    <Border
                        x:Name="WorkspaceTab"
                        Height="32"
                        MinWidth="96"
                        Padding="14,0"
                        Background="{ThemeResource CbTabActiveFillBrush}"
                        CornerRadius="8,8,0,0">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Fill="{ThemeResource CbAccentBrush}" />
                            <TextBlock
                                x:Name="WorkspaceTabText"
                                FontSize="12"
                                Foreground="{ThemeResource CbTextPrimaryBrush}"
                                Text="Default" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Command bar (48 px); under hairlines filled, with a hairline above and below. -->
            <Border
                x:Name="CommandBarFrame"
                Grid.Row="1"
                BorderBrush="{ThemeResource CbDividerBrush}"
                BorderThickness="0">
                <Grid
                    x:Name="CommandBar"
                    Padding="10,0"
                    ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="BackButton"
                        AutomationProperties.Name="Back"
                        Style="{StaticResource CbSubtleButtonStyle}"
                        ToolTipService.ToolTip="Back (Alt+Left)">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                    </Button>
                    <Button
                        x:Name="ForwardButton"
                        Grid.Column="1"
                        AutomationProperties.Name="Forward"
                        Style="{StaticResource CbSubtleButtonStyle}"
                        ToolTipService.ToolTip="Forward (Alt+Right)">
                        <FontIcon FontSize="14" Glyph="&#xE72A;" />
                    </Button>
                    <Button
                        x:Name="UpButton"
                        Grid.Column="2"
                        AutomationProperties.Name="Up"
                        Style="{StaticResource CbSubtleButtonStyle}"
                        ToolTipService.ToolTip="Up (Backspace)">
                        <FontIcon FontSize="14" Glyph="&#xE74A;" />
                    </Button>

                    <Grid
                        x:Name="AddressBar"
                        Grid.Column="3"
                        Height="32"
                        Margin="6,0">
                        <Border
                            x:Name="CrumbBar"
                            Padding="4,0,6,0"
                            Background="{ThemeResource CbControlFillBrush}"
                            BorderBrush="{StaticResource CbFieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <ScrollViewer
                                x:Name="CrumbScroller"
                                HorizontalScrollBarVisibility="Hidden"
                                HorizontalScrollMode="Enabled"
                                IsTabStop="False"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <StackPanel
                                    x:Name="Crumbs"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2" />
                            </ScrollViewer>
                        </Border>
                        <TextBox
                            x:Name="AddressEdit"
                            AutomationProperties.Name="Address"
                            FontSize="13"
                            Visibility="Collapsed" />
                    </Grid>

                    <!-- Search (Ctrl+F): the core searches the active pane's folder; the hits show in that pane. -->
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="4"
                        Height="32"
                        AutomationProperties.Name="Search files"
                        ToolTipService.ToolTip="Search files by name (Ctrl+F)" />

                    <Rectangle
                        Grid.Column="5"
                        Width="1"
                        Height="20"
                        Margin="6,0"
                        Fill="{ThemeResource CbOverlayStrokeBrush}" />

                    <Button
                        x:Name="DualButton"
                        Grid.Column="6"
                        Padding="10,0"
                        AutomationProperties.Name="Toggle dual pane"
                        Style="{StaticResource CbSubtleButtonStyle}"
                        ToolTipService.ToolTip="Toggle dual pane (Ctrl+Shift+D)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                x:Name="DualIcon"
                                FontSize="14"
                                Glyph="&#xE89A;" />
                            <TextBlock
                                x:Name="DualLabel"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="Dual" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="TerminalButton"
                        Grid.Column="7"
                        AutomationProperties.Name="Toggle terminal"
                        Style="{StaticResource CbSubtleButtonStyle}"
                        ToolTipService.ToolTip="Toggle terminal (Ctrl+`)">
                        <FontIcon
                            x:Name="TerminalIcon"
                            FontSize="14"
                            Glyph="&#xE756;" />
                    </Button>
                    <Button
                        x:Name="MarketplaceButton"
                        Grid.Column="8"
                        AutomationProperties.Name="Marketplace"
                        Style="{StaticResource CbSubtleButtonStyle}"
                        ToolTipService.ToolTip="Marketplace (Ctrl+Shift+X)">
                        <FontIcon
                            x:Name="MarketplaceIcon"
                            FontSize="14"
                            Glyph="&#xE719;" />
                    </Button>
                    <Button
                        x:Name="PaletteButton"
                        Grid.Column="9"
                        AutomationProperties.Name="Command palette"
                        Style="{StaticResource CbSubtleButtonStyle}"
                        ToolTipService.ToolTip="Command palette (Ctrl+Shift+P)">
                        <FontIcon
                            FontSize="14"
                            Glyph="&#xE712;"
                            RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform Angle="90" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                </Grid>
            </Border>

            <!-- Body: sidebar and the main column, 8 px gutters (the theme's bodyPadding and gap). -->
            <Grid
                x:Name="Body"
                Grid.Row="2"
                Padding="8,0,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:Sidebar x:Name="SidebarView" Margin="0,0,8,0" />

                <!--
                  The main column: the panes, and the Tool Dock under them (layout
                  classic) or beside them (layout right), behind an 8 px splitter.
                  The dock only changes cells, so its WebView2 is never re-parented.
                -->
                <Grid x:Name="MainColumn" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition x:Name="BottomGapRow" Height="0" />
                        <RowDefinition x:Name="BottomDockRow" Height="0" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="RightGapColumn" Width="0" />
                        <ColumnDefinition x:Name="RightDockColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="PanesGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="RightColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <views:FilePane x:Name="LeftPane" Margin="0,0,4,0" />
                        <views:FilePane
                            x:Name="RightPane"
                            Grid.Column="1"
                            Margin="4,0,0,0" />
                        <!-- A pane's editor tab (design view D) covers its listing while a Tool Extension shows a file. -->
                        <views:EditorPane x:Name="LeftEditor" Margin="0,0,4,0" />
                        <views:EditorPane
                            x:Name="RightEditor"
                            Grid.Column="1"
                            Margin="4,0,0,0" />
                    </Grid>
                    <!-- Above the panes and the dock: with no gap the handle lies over their edges. -->
                    <views:SplitterBar
                        x:Name="BottomSplitter"
                        Grid.Row="1"
                        Canvas.ZIndex="1"
                        Orientation="Horizontal"
                        Visibility="Collapsed" />
                    <views:SplitterBar
                        x:Name="RightSplitter"
                        Grid.Column="1"
                        Canvas.ZIndex="1"
                        Orientation="Vertical"
                        Visibility="Collapsed" />
                    <views:ToolDock
                        x:Name="Dock"
                        Grid.Row="2"
                        Visibility="Collapsed" />
                </Grid>

                <!-- The marketplace (design view C) takes the main column's place; the sidebar and the status bar stay. -->
                <views:MarketplaceView x:Name="MarketView" Grid.Column="1" />
            </Grid>

            <!-- The function-key bar (chrome fkeyBar): collapsed, and its row with it, unless the theme shows it. -->
            <views:FunctionKeyBar x:Name="FkeyBar" Grid.Row="3" />

            <!-- Status bar (26 px). -->
            <Border
                Grid.Row="4"
                BorderBrush="{ThemeResource CbDividerBrush}"
                BorderThickness="0,1,0,0">
                <Grid
                    x:Name="StatusGrid"
                    Padding="14,0"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ItemsText"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbStatusTextBrush}" />
                    <TextBlock
                        x:Name="SelectionText"
                        Grid.Column="1"
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbStatusTextBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="NoticeText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbStatusTextBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel
                        x:Name="StatusKeys"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="16">
                        <TextBlock
                            x:Name="ChordText"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource CbAccentBrush}"
                            Visibility="Collapsed" />
                        <!-- Quick search: the letters typed in a pane, until a second passes without one. -->
                        <TextBlock
                            x:Name="QuickText"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource CbAccentBrush}"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <!-- The minimized transfer (design view E): an 80 x 4 px track and "Copying · 45%". -->
                    <Button
                        x:Name="TransferPill"
                        Grid.Column="4"
                        Height="20"
                        MinWidth="0"
                        Padding="8,0"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.Name="Show the transfer"
                        Background="{ThemeResource CbPillFillBrush}"
                        CornerRadius="10"
                        Style="{StaticResource CbSubtleButtonStyle}"
                        ToolTipService.ToolTip="Show the transfer"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid
                                Width="80"
                                Height="4"
                                VerticalAlignment="Center"
                                Background="{ThemeResource CbPillTrackBrush}"
                                CornerRadius="2">
                                <Rectangle
                                    x:Name="PillFill"
                                    Fill="{ThemeResource CbAccentBrush}"
                                    RadiusX="2"
                                    RadiusY="2" />
                            </Grid>
                            <TextBlock
                                x:Name="PillText"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource CbTextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        Grid.Column="5"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbStatusTextBrush}"
                        Text="UTF-8" />
                    <TextBlock
                        x:Name="LayoutText"
                        Grid.Column="6"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbStatusTextBrush}" />
                    <Button
                        x:Name="PaletteKeycap"
                        Grid.Column="7"
                        Height="18"
                        MinWidth="0"
                        Padding="6,1"
                        AutomationProperties.Name="Command palette"
                        Background="{ThemeResource CbHoverFillBrush}"
                        CornerRadius="3"
                        Style="{StaticResource CbSubtleButtonStyle}">
                        <TextBlock
                            FontFamily="{StaticResource CbMonoFont}"
                            FontSize="11"
                            Foreground="{ThemeResource CbStatusTextBrush}"
                            Text="Ctrl+Shift+P" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- The transfer flyout: right 16 px, bottom 36 px (above the status bar), non-modal. -->
        <views:TransferFlyout
            x:Name="TransferView"
            Margin="0,0,16,36"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom" />

        <views:FileContextMenu x:Name="FileMenu" />

        <views:CommandPalette x:Name="Palette" Visibility="Collapsed" />

        <!-- The pattern box and the pinned folders list, in the palette's frame. -->
        <views:PromptBox x:Name="PromptView" Visibility="Collapsed" />

        <views:ThemePicker x:Name="ThemesView" />

        <views:PluginsPanel x:Name="PluginsView" />

        <views:ReviewDialog x:Name="ReviewView" />
    </Grid>
</Window>
