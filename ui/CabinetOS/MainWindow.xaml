<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CabinetOS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CabinetOS.Views"
    Title="CabinetOS">
    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- The default look's sizes; the theme's metrics replace them (MainWindow.Metrics.cs). -->
        <Grid x:Name="ShellContent">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopRow" Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="StatusRow" Height="26" />
            </Grid.RowDefinitions>

            <!--
              The top row (Phase 16; docs/ui.md, "The top row"): the menu, the app icon and the workspace pill on the left,
              the command center in the middle, the view buttons and Windows' caption buttons on the right. The whole row
              is the window's drag area except over its controls (MainWindow.Shell.cs, UpdateDragRegions).
            -->
            <Border
                x:Name="TopBar"
                Background="{ThemeResource CbBarFillBrush}"
                BorderBrush="{ThemeResource CbShellHairlineBrush}"
                BorderThickness="0,0,0,1">
                <Grid x:Name="TopRowGrid">
                    <StackPanel
                        x:Name="TopLeft"
                        Padding="4,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="MenuButton"
                            Width="36"
                            Height="36"
                            AllowFocusOnInteraction="False"
                            AutomationProperties.Name="Menu"
                            IsTabStop="False"
                            Style="{StaticResource CbSubtleButtonStyle}"
                            ToolTipService.ToolTip="Menu">
                            <Grid>
                                <FontIcon FontSize="14" Glyph="&#xE700;" />
                                <!-- An update waits for a restart (docs/ui.md, "Updates"). -->
                                <Ellipse
                                    x:Name="MenuUpdateDot"
                                    Width="6"
                                    Height="6"
                                    Margin="0,-3,-5,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Fill="{ThemeResource CbAccentBrush}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Border
                            x:Name="AppTile"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Background="{StaticResource CbAppTileBrush}"
                            CornerRadius="4" />
                        <!-- The accent at 18 % under the button, so its hover fill lies over the accent. -->
                        <Border
                            x:Name="WorkspacePillFrame"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CbWorkspacePillFillBrush}"
                            CornerRadius="4">
                            <Button
                                x:Name="WorkspacePill"
                                Height="24"
                                Padding="8,0"
                                AllowFocusOnInteraction="False"
                                AutomationProperties.Name="Workspace"
                                CornerRadius="4"
                                IsTabStop="False"
                                Style="{StaticResource CbSubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource CbAccentBrush}" />
                                    <TextBlock
                                        x:Name="WorkspaceName"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource CbTextPrimaryBrush}"
                                        Text="Default" />
                                    <TextBlock
                                        x:Name="WorkspaceBranch"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CbMonoFont}"
                                        FontSize="10"
                                        Foreground="{ThemeResource CbTextSecondaryBrush}"
                                        Visibility="Collapsed" />
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="8"
                                        Foreground="{ThemeResource CbTextSecondaryBrush}"
                                        Glyph="&#xE70D;" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>

                    <!-- The command center, placed by TopRowLayout: centred, clamp(200px, 34%, 380px), hidden below 640 px. -->
                    <Canvas x:Name="CenterLayer">
                        <Border
                            x:Name="CommandCenterFrame"
                            Height="24"
                            Background="{ThemeResource CbControlFillBrush}"
                            BorderBrush="{ThemeResource CbOverlayStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Button
                                x:Name="CommandCenter"
                                Padding="8,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AllowFocusOnInteraction="False"
                                AutomationProperties.Name="Quick Open"
                                CornerRadius="3"
                                IsTabStop="False"
                                Style="{StaticResource CbSubtleButtonStyle}"
                                ToolTipService.ToolTip="Quick Open (Ctrl+P)">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource CbTextTertiaryBrush}"
                                        Glyph="&#xE721;" />
                                    <TextBlock
                                        x:Name="CommandCenterText"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource CbTextSecondaryBrush}"
                                        Text="Default"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="CommandCenterKeys"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CbMonoFont}"
                                        FontSize="11"
                                        Foreground="{ThemeResource CbHintTextBrush}"
                                        Text="Ctrl+P" />
                                </Grid>
                            </Button>
                        </Border>
                    </Canvas>

                    <StackPanel
                        x:Name="TopRight"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="DualButton"
                            Width="36"
                            Height="36"
                            AllowFocusOnInteraction="False"
                            AutomationProperties.Name="Toggle dual pane"
                            IsTabStop="False"
                            Style="{StaticResource CbSubtleButtonStyle}"
                            ToolTipService.ToolTip="Toggle dual pane (Ctrl+Shift+D)">
                            <FontIcon
                                x:Name="DualIcon"
                                FontSize="14"
                                Glyph="&#xE89A;" />
                        </Button>
                        <Button
                            x:Name="TerminalButton"
                            Width="36"
                            Height="36"
                            AllowFocusOnInteraction="False"
                            AutomationProperties.Name="Toggle terminal"
                            IsTabStop="False"
                            Style="{StaticResource CbSubtleButtonStyle}"
                            ToolTipService.ToolTip="Toggle terminal (Ctrl+`)">
                            <FontIcon
                                x:Name="TerminalIcon"
                                FontSize="14"
                                Glyph="&#xE756;" />
                        </Button>
                        <Button
                            x:Name="MarketplaceButton"
                            Width="36"
                            Height="36"
                            AllowFocusOnInteraction="False"
                            AutomationProperties.Name="Marketplace"
                            IsTabStop="False"
                            Style="{StaticResource CbSubtleButtonStyle}"
                            ToolTipService.ToolTip="Marketplace (Ctrl+Shift+X)">
                            <FontIcon
                                x:Name="MarketplaceIcon"
                                FontSize="14"
                                Glyph="&#xE719;" />
                        </Button>
                        <Button
                            x:Name="PaletteButton"
                            Width="36"
                            Height="36"
                            AllowFocusOnInteraction="False"
                            AutomationProperties.Name="Command palette"
                            IsTabStop="False"
                            Style="{StaticResource CbSubtleButtonStyle}"
                            ToolTipService.ToolTip="Command palette (Ctrl+Shift+P)">
                            <FontIcon
                                x:Name="PaletteIcon"
                                FontSize="14"
                                Glyph="&#xE712;"
                                RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform>
                                    <RotateTransform Angle="90" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Button>
                        <Button
                            x:Name="SettingsButton"
                            Width="36"
                            Height="36"
                            AllowFocusOnInteraction="False"
                            AutomationProperties.Name="Settings"
                            IsTabStop="False"
                            Style="{StaticResource CbSubtleButtonStyle}"
                            ToolTipService.ToolTip="Settings (Ctrl+,)">
                            <FontIcon FontSize="14" Glyph="&#xE713;" />
                        </Button>
                        <Rectangle
                            x:Name="CaptionDivider"
                            Width="1"
                            Height="16"
                            Margin="6,0"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource CbShellHairlineBrush}" />
                        <!-- Where Windows draws the minimize, maximize and close buttons (AppWindow.TitleBar.RightInset). -->
                        <Border x:Name="CaptionSpace" Width="138" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body: the activity rail (rail layout only), the sidebar and the main column, 8 px gutters (the theme's bodyPadding and gap). -->
            <Grid
                x:Name="Body"
                Grid.Row="1"
                Padding="8,0,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:ActivityRail
                    x:Name="Rail"
                    Margin="0,0,8,0"
                    Visibility="Collapsed" />

                <!--
                  The sidebar's column: the Explorer (pinned folders, drives, and in the rail layout the folder tree), the Search
                  view, and the pages of tools with a sidebar page, one over another; the divider lies over the gap on its right.
                -->
                <Grid x:Name="SidebarHost" Grid.Column="1">
                    <Grid x:Name="SidebarColumn" Margin="0,0,8,0">
                        <views:Sidebar x:Name="SidebarView" />
                        <views:SearchPanel x:Name="SearchPanelView" Visibility="Collapsed" />
                        <Grid x:Name="ToolViews" Visibility="Collapsed" />
                    </Grid>
                    <views:SplitterBar
                        x:Name="SidebarSplitter"
                        Width="8"
                        HorizontalAlignment="Right"
                        Canvas.ZIndex="1"
                        Orientation="Vertical"
                        Visibility="Collapsed" />
                </Grid>

                <!--
                  The main column: the panes, and the Tool Dock under them (layout
                  classic) or beside them (layout right), behind an 8 px splitter.
                  The dock only changes cells, so its WebView2 is never re-parented.
                -->
                <Grid x:Name="MainColumn" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition x:Name="BottomGapRow" Height="0" />
                        <RowDefinition x:Name="BottomDockRow" Height="0" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="RightGapColumn" Width="0" />
                        <ColumnDefinition x:Name="RightDockColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="PanesGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="RightColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <!--
                          Each pane, top to bottom (Phase 16): its tab strip, its breadcrumb row with Back, Forward and
                          Up, and its listing. A Tool Extension's editor (design view D) covers the listing while the
                          pane's front tab shows one.
                        -->
                        <Grid x:Name="LeftSide" Margin="0,0,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <views:PaneTabs x:Name="LeftTabs" />
                            <views:PaneCrumbs x:Name="LeftCrumbs" Grid.Row="1" />
                            <views:FilePane x:Name="LeftPane" Grid.Row="2" />
                            <views:EditorPane x:Name="LeftEditor" Grid.Row="2" />
                            <views:FindWidget
                                x:Name="LeftFind"
                                Grid.Row="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top" />
                            <views:PreviewPane x:Name="LeftPreview" Grid.Row="2" />
                        </Grid>
                        <Grid
                            x:Name="RightSide"
                            Grid.Column="1"
                            Margin="4,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <views:PaneTabs x:Name="RightTabs" />
                            <views:PaneCrumbs x:Name="RightCrumbs" Grid.Row="1" />
                            <views:FilePane x:Name="RightPane" Grid.Row="2" />
                            <views:EditorPane x:Name="RightEditor" Grid.Row="2" />
                            <views:FindWidget
                                x:Name="RightFind"
                                Grid.Row="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top" />
                            <views:PreviewPane x:Name="RightPreview" Grid.Row="2" />
                        </Grid>
                    </Grid>
                    <!-- Above the panes and the dock: with no gap the handle lies over their edges. -->
                    <views:SplitterBar
                        x:Name="BottomSplitter"
                        Grid.Row="1"
                        Canvas.ZIndex="1"
                        Orientation="Horizontal"
                        Visibility="Collapsed" />
                    <views:SplitterBar
                        x:Name="RightSplitter"
                        Grid.Column="1"
                        Canvas.ZIndex="1"
                        Orientation="Vertical"
                        Visibility="Collapsed" />
                    <views:ToolDock
                        x:Name="Dock"
                        Grid.Row="2"
                        Visibility="Collapsed" />
                </Grid>

                <!-- The marketplace (design view C) takes the main column's place; the sidebar and the status bar stay. -->
                <views:MarketplaceView x:Name="MarketView" Grid.Column="2" />
            </Grid>

            <!-- The function-key bar (chrome fkeyBar): collapsed, and its row with it, unless the theme shows it. -->
            <views:FunctionKeyBar x:Name="FkeyBar" Grid.Row="2" />

            <!-- Status bar (26 px). -->
            <Border
                Grid.Row="3"
                BorderBrush="{ThemeResource CbDividerBrush}"
                BorderThickness="0,1,0,0">
                <Grid
                    x:Name="StatusGrid"
                    Padding="14,0"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ItemsText"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbStatusTextBrush}" />
                    <TextBlock
                        x:Name="SelectionText"
                        Grid.Column="1"
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbStatusTextBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="NoticeText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbStatusTextBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel
                        x:Name="StatusKeys"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="16">
                        <TextBlock
                            x:Name="ChordText"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource CbAccentBrush}"
                            Visibility="Collapsed" />
                        <!-- Quick search: the letters typed in a pane, until a second passes without one. -->
                        <TextBlock
                            x:Name="QuickText"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource CbAccentBrush}"
                            Visibility="Collapsed" />
                        <!-- The last run crashed while heavy logging was on: the zip with the logs around the crash is in the log folder (docs/ui.md, "Heavy logging"). -->
                        <Button
                            x:Name="CrashFolderLink"
                            Height="20"
                            MinWidth="0"
                            Padding="8,0"
                            AllowFocusOnInteraction="False"
                            AutomationProperties.Name="Open crash folder"
                            Background="{ThemeResource CbPillFillBrush}"
                            CornerRadius="10"
                            IsTabStop="False"
                            Style="{StaticResource CbSubtleButtonStyle}"
                            Visibility="Collapsed">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource CbErrorTextBrush}"
                                Text="Open crash folder" />
                        </Button>
                        <!-- Heavy logging is on (docs/ui.md, "Heavy logging"): the pill says so, and a click turns it off. -->
                        <Button
                            x:Name="HeavyPill"
                            Height="20"
                            MinWidth="0"
                            Padding="8,0"
                            AllowFocusOnInteraction="False"
                            Background="{ThemeResource CbPillFillBrush}"
                            CornerRadius="10"
                            IsTabStop="False"
                            Style="{StaticResource CbSubtleButtonStyle}"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="HeavyPillText"
                                VerticalAlignment="Center"
                                CharacterSpacing="60"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CbAccentBrush}" />
                        </Button>
                        <!-- An update (docs/ui.md, "Updates"): the transfer pill's look while it downloads, "Update ready · Restart" after. -->
                        <Button
                            x:Name="UpdatePill"
                            Height="20"
                            MinWidth="0"
                            Padding="8,0"
                            AllowFocusOnInteraction="False"
                            Background="{ThemeResource CbPillFillBrush}"
                            CornerRadius="10"
                            IsTabStop="False"
                            Style="{StaticResource CbSubtleButtonStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid
                                    x:Name="UpdatePillTrack"
                                    Width="80"
                                    Height="4"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource CbPillTrackBrush}"
                                    CornerRadius="2">
                                    <Rectangle
                                        x:Name="UpdatePillFill"
                                        Width="0"
                                        HorizontalAlignment="Left"
                                        Fill="{ThemeResource CbAccentBrush}"
                                        RadiusX="2"
                                        RadiusY="2" />
                                </Grid>
                                <TextBlock
                                    x:Name="UpdatePillText"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource CbTextPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- The minimized transfer (design view E): an 80 x 4 px track and "Copying · 45%". -->
                    <Button
                        x:Name="TransferPill"
                        Grid.Column="4"
                        Height="20"
                        MinWidth="0"
                        Padding="8,0"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.Name="Show the transfer"
                        Background="{ThemeResource CbPillFillBrush}"
                        CornerRadius="10"
                        IsTabStop="False"
                        Style="{StaticResource CbSubtleButtonStyle}"
                        ToolTipService.ToolTip="Show the transfer"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid
                                Width="80"
                                Height="4"
                                VerticalAlignment="Center"
                                Background="{ThemeResource CbPillTrackBrush}"
                                CornerRadius="2">
                                <Rectangle
                                    x:Name="PillFill"
                                    Fill="{ThemeResource CbAccentBrush}"
                                    RadiusX="2"
                                    RadiusY="2" />
                            </Grid>
                            <TextBlock
                                x:Name="PillText"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource CbTextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="EncodingText"
                        Grid.Column="5"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbStatusTextBrush}"
                        Text="UTF-8" />
                    <TextBlock
                        x:Name="LayoutText"
                        Grid.Column="6"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbStatusTextBrush}" />
                    <Button
                        x:Name="PaletteKeycap"
                        Grid.Column="7"
                        Height="18"
                        MinWidth="0"
                        Padding="6,1"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.Name="Command palette"
                        Background="{ThemeResource CbHoverFillBrush}"
                        CornerRadius="3"
                        IsTabStop="False"
                        Style="{StaticResource CbSubtleButtonStyle}">
                        <TextBlock
                            FontFamily="{StaticResource CbMonoFont}"
                            FontSize="11"
                            Foreground="{ThemeResource CbStatusTextBrush}"
                            Text="Ctrl+Shift+P" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- The transfer flyout: right 16 px, bottom 36 px (above the status bar), non-modal. -->
        <views:TransferFlyout
            x:Name="TransferView"
            Margin="0,0,16,36"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom" />

        <views:FileContextMenu x:Name="FileMenu" />

        <!-- The right-click menu's edit mode ("Edit Menu…"); the palette's prompt opens over it (Add Command…). -->
        <views:ContextMenuEditor x:Name="MenuEditorView" />

        <views:CommandPalette x:Name="Palette" Visibility="Collapsed" />
        <views:QuickOpen x:Name="QuickOpenView" />

        <!-- The pattern box and the pinned folders list, in the palette's frame. -->
        <views:PromptBox x:Name="PromptView" Visibility="Collapsed" />

        <views:ThemePicker x:Name="ThemesView" />

        <views:PluginsPanel x:Name="PluginsView" />

        <views:ReviewDialog x:Name="ReviewView" />
    </Grid>
</Window>
