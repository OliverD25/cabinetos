<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CabinetOS.Views.PaneTabs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!--
      A pane's tab strip (Phases 12 and 16; docs/ui.md, "Tabs"): WinUI's TabView used as the strip only, at the top of
      the pane, with one tab or more. The keyboard never rests on it: the pane keeps it, so the keys stay the pane's
      (IsTabStop, AllowFocusOnInteraction); Ctrl+T, Ctrl+W, Ctrl+Tab and Ctrl+1 to Ctrl+9 do what its clicks do. The
      height is the theme's tabRow; the 2 px bar over the tab in front is drawn here, in the accent in the active pane.
    -->
    <Border
        x:Name="Frame"
        Background="{ThemeResource CbBarFillBrush}"
        BorderBrush="{ThemeResource CbShellHairlineBrush}"
        BorderThickness="0,0,0,1">
        <Grid x:Name="Root">
            <TabView
                x:Name="Strip"
                VerticalAlignment="Top"
                AllowDropTabs="False"
                AllowFocusOnInteraction="False"
                Background="Transparent"
                CanDragTabs="False"
                CanReorderTabs="False"
                CloseButtonOverlayMode="Always"
                IsAddTabButtonVisible="True"
                IsTabStop="False"
                TabWidthMode="SizeToContent">
                <TabView.Resources>
                    <!-- WinUI keeps 8 px above the strip and 3 px inside a tab; the row's height is the theme's, so none. -->
                    <Thickness x:Key="TabViewHeaderPadding">0</Thickness>
                    <x:Double x:Key="TabViewItemMaxWidth">160</x:Double>
                    <x:Double x:Key="TabViewItemMinWidth">60</x:Double>
                    <!-- The window's own tokens, so a theme's colours reach the strip: the same brush objects, changed in place. -->
                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="CbTabActiveFillBrush" />
                    <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOver" ResourceKey="CbHoverFillBrush" />
                    <StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="CbTextPrimaryBrush" />
                    <StaticResource x:Key="TabViewItemHeaderForeground" ResourceKey="CbTabInactiveTextBrush" />
                    <StaticResource x:Key="TabViewItemHeaderForegroundPointerOver" ResourceKey="CbTextPrimaryBrush" />
                    <StaticResource x:Key="TabViewItemSeparator" ResourceKey="CbShellHairlineBrush" />
                    <StaticResource x:Key="TabViewBorderBrush" ResourceKey="CbShellHairlineBrush" />
                </TabView.Resources>
                <TabView.TabStripFooter>
                    <!-- The editors a file may open in: the palette, filtered to them (the design's editor hint), at the strip's right end. -->
                    <Button
                        x:Name="OpenWithButton"
                        Height="24"
                        MinWidth="0"
                        Margin="4,0,4,0"
                        Padding="8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.Name="Open with…"
                        IsTabStop="False"
                        Style="{StaticResource CbSubtleButtonStyle}"
                        ToolTipService.ToolTip="Open with… (the editors, in the command palette)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE7AC;" />
                            <TextBlock
                                x:Name="OpenWithText"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Text="Open with…" />
                        </StackPanel>
                    </Button>
                </TabView.TabStripFooter>
            </TabView>
            <Rectangle
                x:Name="AccentLine"
                Height="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="{ThemeResource CbAccentBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
