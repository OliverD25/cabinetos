<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CabinetOS.Views.PaneTabs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    Visibility="Collapsed">
    <!--
      A pane's tab row (Phase 12; docs/ui.md, "Tabs"): WinUI's TabView used as the strip only, over the
      pane's list and its editor. It shows from the second tab on. The keyboard never rests on it: the
      pane keeps it, so the keys stay the pane's (IsTabStop, AllowFocusOnInteraction). The height is
      the theme's tabRow; the 2 px accent line over the tab in front of the active pane is drawn here.
    -->
    <Grid x:Name="Root">
        <TabView
            x:Name="Strip"
            VerticalAlignment="Top"
            AllowDropTabs="False"
            AllowFocusOnInteraction="False"
            Background="Transparent"
            CanDragTabs="False"
            CanReorderTabs="False"
            CloseButtonOverlayMode="OnPointerOver"
            IsAddTabButtonVisible="False"
            IsTabStop="False"
            TabWidthMode="SizeToContent">
            <TabView.Resources>
                <!-- WinUI keeps 8 px above the strip and 3 px inside a tab; the row's height is the theme's, so none. -->
                <Thickness x:Key="TabViewHeaderPadding">0</Thickness>
                <x:Double x:Key="TabViewItemMaxWidth">220</x:Double>
                <x:Double x:Key="TabViewItemMinWidth">72</x:Double>
                <!-- The window's own tokens, so a theme's colours reach the row: the same brush objects, changed in place. -->
                <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="CbTabActiveFillBrush" />
                <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOver" ResourceKey="CbHoverFillBrush" />
                <StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="CbTextPrimaryBrush" />
                <StaticResource x:Key="TabViewItemHeaderForeground" ResourceKey="CbTextSecondaryBrush" />
                <StaticResource x:Key="TabViewItemHeaderForegroundPointerOver" ResourceKey="CbTextPrimaryBrush" />
                <StaticResource x:Key="TabViewBorderBrush" ResourceKey="CbDividerBrush" />
            </TabView.Resources>
        </TabView>
        <Rectangle
            x:Name="AccentLine"
            Height="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Fill="{ThemeResource CbAccentBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
