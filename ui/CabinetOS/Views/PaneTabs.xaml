<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CabinetOS.Views.PaneTabs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowFocusOnInteraction="False"
    IsTabStop="False">
    <!--
      A pane's tab strip (Phases 12 and 16; docs/ui.md, "Tabs"): the window's own strip, drawn as the design draws it, not
      WinUI's TabView. The tabs are built in code (PaneTabs.xaml.cs) and lie in a row that scrolls sideways when they do
      not fit, with the "+" after the last one (when they do not fit it leaves the row and stays at the strip's end, in
      PinnedAdd). "Open with…" is in the pane's toolbar row since v2 of the shell redesign (PaneCrumbs).
      The keyboard never rests on the strip: the pane keeps it, so the keys stay the pane's (IsTabStop,
      AllowFocusOnInteraction on every element that could take it); Ctrl+T, Ctrl+W, Ctrl+Tab and Ctrl+1 to Ctrl+9 do what
      its clicks do. The height is the theme's tabRow.
    -->
    <UserControl.Resources>
        <!-- A glyph as a button, with no box: the tab's × and the strip's "+". It rests at white 50 % and turns white on hover. -->
        <Style x:Key="TabGlyphButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{ThemeResource CbTextTertiaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <ContentPresenter
                                x:Name="Presenter"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Presenter.Foreground" Value="{ThemeResource CbTextPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Presenter.Foreground" Value="{ThemeResource CbTextPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border
        x:Name="Frame"
        Background="{ThemeResource CbBarFillBrush}"
        BorderBrush="{ThemeResource CbShellHairlineBrush}"
        BorderThickness="0,0,0,1">
        <Grid x:Name="Root">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer
                x:Name="Scroller"
                AllowFocusOnInteraction="False"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                IsTabStop="False"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <StackPanel x:Name="TabList" Orientation="Horizontal">
                    <!-- The tabs come before it, in code. The code moves it to PinnedAdd while the tabs overflow. -->
                    <Button
                        x:Name="AddButton"
                        Width="24"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.Name="New tab"
                        IsTabStop="False"
                        Style="{StaticResource TabGlyphButtonStyle}">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="PinnedAdd" Grid.Column="1" />
        </Grid>
    </Border>
</UserControl>
