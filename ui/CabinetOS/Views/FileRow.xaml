<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CabinetOS.Views.FileRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CabinetOS.Views"
    IsTabStop="False">
    <!-- The default look's sizes; the theme's metrics replace them (FileRow.ApplyMetrics). -->
    <Grid
        x:Name="Root"
        Height="30"
        Background="Transparent"
        CornerRadius="4">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="RowStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource CbHoverFillBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource CbSelectedFillBrush}" />
                        <Setter Target="Pill.Visibility" Value="Visible" />
                        <Setter Target="NameText.Foreground" Value="{ThemeResource CbTextPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <!-- Over striped rows (chrome rowStripes) a selected row is filled stronger, as in the handout. -->
                <VisualState x:Name="SelectedStriped">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource CbStripedSelectedFillBrush}" />
                        <Setter Target="Pill.Visibility" Value="Visible" />
                        <Setter Target="NameText.Foreground" Value="{ThemeResource CbTextPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- The keyboard's row when it is not simply the one selected row. -->
        <Border
            x:Name="CursorOutline"
            BorderBrush="{ThemeResource CbCursorStrokeBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="Collapsed" />

        <Rectangle
            x:Name="Pill"
            Width="3"
            Height="16"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Fill="{ThemeResource CbAccentBrush}"
            RadiusX="1.5"
            RadiusY="1.5"
            Visibility="Collapsed" />

        <Grid x:Name="Columns" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="NameColumn"
                    Width="*"
                    MinWidth="120" />
                <ColumnDefinition x:Name="ModifiedColumn" Width="0.55*" />
                <ColumnDefinition x:Name="TypeColumn" Width="0.45*" />
                <ColumnDefinition x:Name="SizeColumn" Width="64" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="NameCell" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center">
                    <FontIcon
                        x:Name="Icon"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource CbRowMetaBrush}" />
                    <local:FolderGlyph
                        x:Name="FolderIcon"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <!-- The shell's icon (get_icon) replaces the glyph once it arrives. -->
                    <Image
                        x:Name="IconImage"
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <!-- A link (junction, symbolic link, mount point): a badge on the icon's lower left, as Explorer's arrow. -->
                    <Border
                        x:Name="LinkBadge"
                        Width="10"
                        Height="10"
                        Margin="-3,0,0,-3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource CbDialogFillBrush}"
                        BorderBrush="{ThemeResource CbOverlayStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Visibility="Collapsed">
                        <FontIcon
                            FontSize="7"
                            Foreground="{ThemeResource CbAccentBrush}"
                            Glyph="&#xE71B;" />
                    </Border>
                </Grid>
                <TextBlock
                    x:Name="NameText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource CbRowTextBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <!-- Not on this disk (a cloud placeholder): opening it downloads it. -->
                <FontIcon
                    x:Name="CloudMark"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Not on this disk"
                    FontSize="12"
                    Foreground="{ThemeResource CbTextTertiaryBrush}"
                    Glyph="&#xE753;"
                    ToolTipService.ToolTip="Not on this disk: opening it downloads it"
                    Visibility="Collapsed" />
            </Grid>
            <TextBlock
                x:Name="ModifiedText"
                Grid.Column="1"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource CbRowMetaBrush}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="TypeText"
                Grid.Column="2"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource CbRowMetaBrush}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="SizeText"
                Grid.Column="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource CbRowMetaBrush}"
                TextWrapping="NoWrap" />
        </Grid>
    </Grid>
</UserControl>
