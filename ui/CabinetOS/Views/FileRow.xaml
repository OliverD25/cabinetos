<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CabinetOS.Views.FileRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid
        x:Name="Root"
        Height="{StaticResource CbRowHeight}"
        Background="Transparent"
        CornerRadius="4">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="RowStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource CbHoverFillBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource CbSelectedFillBrush}" />
                        <Setter Target="Pill.Visibility" Value="Visible" />
                        <Setter Target="NameText.Foreground" Value="{ThemeResource CbTextPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Rectangle
            x:Name="Pill"
            Width="3"
            Height="16"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Fill="{ThemeResource CbAccentBrush}"
            RadiusX="1.5"
            RadiusY="1.5"
            Visibility="Collapsed" />

        <Grid Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="0.55*" />
                <ColumnDefinition Width="0.45*" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    x:Name="Icon"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource CbRowMetaBrush}" />
                <TextBlock
                    x:Name="NameText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource CbRowTextBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
            <TextBlock
                x:Name="ModifiedText"
                Grid.Column="1"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource CbRowMetaBrush}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="TypeText"
                Grid.Column="2"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource CbRowMetaBrush}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="SizeText"
                Grid.Column="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource CbRowMetaBrush}"
                TextWrapping="NoWrap" />
        </Grid>
    </Grid>
</UserControl>
