<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CabinetOS.Views.PromptBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    UseSystemFocusVisuals="False">
    <UserControl.Resources>
        <!-- The palette's entrance: 160 ms, opacity, 6 px down, scale .98 to 1. -->
        <Storyboard x:Key="Entrance">
            <DoubleAnimation
                Storyboard.TargetName="Panel"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.16" />
            <DoubleAnimation
                Storyboard.TargetName="PanelTransform"
                Storyboard.TargetProperty="TranslateY"
                From="-6"
                To="0"
                Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="PanelTransform"
                Storyboard.TargetProperty="ScaleX"
                From="0.98"
                To="1"
                Duration="0:0:0.16" />
            <DoubleAnimation
                Storyboard.TargetName="PanelTransform"
                Storyboard.TargetProperty="ScaleY"
                From="0.98"
                To="1"
                Duration="0:0:0.16" />
        </Storyboard>
    </UserControl.Resources>

    <!-- The palette's frame: a transparent scrim, the Acrylic panel under the title bar. -->
    <Grid x:Name="Scrim" Background="Transparent">
        <Border
            x:Name="Panel"
            Width="560"
            Margin="0,64,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource CbPaletteAcrylicBrush}"
            BorderBrush="{ThemeResource CbOverlayStrokeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            RenderTransformOrigin="0.5,0"
            Translation="0,0,32">
            <Border.RenderTransform>
                <CompositeTransform x:Name="PanelTransform" />
            </Border.RenderTransform>
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="InputRow"
                    Padding="12,10,12,8"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Height="34"
                        Padding="10,0"
                        Background="{ThemeResource CbPaletteInputFillBrush}"
                        BorderBrush="{StaticResource CbPaletteInputAccentBrush}"
                        BorderThickness="1,1,1,2"
                        CornerRadius="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="LabelText"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource CbTextTertiaryBrush}" />
                            <TextBox
                                x:Name="Input"
                                Grid.Column="1"
                                MinHeight="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                    </Border>
                    <CheckBox
                        x:Name="Option"
                        Grid.Column="1"
                        MinWidth="0"
                        MinHeight="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        IsTabStop="False"
                        Visibility="Collapsed" />
                </Grid>

                <ScrollViewer
                    x:Name="RowsScroller"
                    Grid.Row="1"
                    MaxHeight="360"
                    Padding="6,0,6,8"
                    HorizontalScrollMode="Disabled"
                    IsTabStop="False"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Rows" />
                </ScrollViewer>

                <Border
                    x:Name="HintBar"
                    Grid.Row="2"
                    BorderBrush="{ThemeResource CbDividerBrush}"
                    BorderThickness="0,1,0,0">
                    <TextBlock
                        x:Name="HintText"
                        Padding="14,6,14,8"
                        FontSize="11"
                        Foreground="{ThemeResource CbHintTextBrush}"
                        TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
