<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CabinetOS.Views.ReviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    Visibility="Collapsed">
    <UserControl.Resources>
        <!-- The design's 160 ms entrance, as the palette's. -->
        <Storyboard x:Key="Entrance">
            <DoubleAnimation
                Storyboard.TargetName="Card"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.16" />
            <DoubleAnimation
                Storyboard.TargetName="CardTransform"
                Storyboard.TargetProperty="ScaleX"
                From="0.98"
                To="1"
                Duration="0:0:0.16" />
            <DoubleAnimation
                Storyboard.TargetName="CardTransform"
                Storyboard.TargetProperty="ScaleY"
                From="0.98"
                To="1"
                Duration="0:0:0.16" />
        </Storyboard>
    </UserControl.Resources>

    <!-- Permissions review (design view C): 440 px on a 40 % black scrim; a click on the scrim cancels. -->
    <Grid x:Name="Scrim" Background="{StaticResource CbScrimBrush}">
        <Border
            x:Name="Card"
            Width="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource CbDialogFillBrush}"
            BorderBrush="{ThemeResource CbOverlayStrokeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            RenderTransformOrigin="0.5,0.5"
            Translation="0,0,48">
            <Border.RenderTransform>
                <CompositeTransform x:Name="CardTransform" />
            </Border.RenderTransform>
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Padding="24,22,24,8" Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="Tile"
                            Width="40"
                            Height="40"
                            CornerRadius="8">
                            <TextBlock
                                x:Name="TileText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="{StaticResource CbOnAccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CbTextPrimaryBrush}"
                                Text="Review permissions" />
                            <TextBlock
                                x:Name="SubtitleText"
                                FontSize="12"
                                Foreground="{ThemeResource CbStatusTextBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        x:Name="SandboxText"
                        Foreground="{ThemeResource CbDialogTextBrush}"
                        TextWrapping="Wrap" />
                    <StackPanel x:Name="Rows" Spacing="6" />
                    <!-- Disabled until the marketplace brings publisher identities; the tooltip says so. -->
                    <Border x:Name="TrustHolder" Background="Transparent">
                        <CheckBox
                            x:Name="TrustBox"
                            MinHeight="0"
                            Padding="10,0,0,0"
                            FontSize="12"
                            IsEnabled="False" />
                    </Border>
                    <TextBlock
                        x:Name="ErrorText"
                        FontSize="12"
                        Foreground="{ThemeResource CbErrorTextBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Padding="24,16"
                    Background="{ThemeResource CbDialogFooterFillBrush}"
                    BorderBrush="{ThemeResource CbDividerBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8">
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="CancelButton"
                            Height="32"
                            Padding="20,0"
                            Content="Cancel" />
                        <Button
                            x:Name="AllowButton"
                            Height="32"
                            Padding="20,0"
                            Content="Allow and install"
                            FontWeight="SemiBold"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
