<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CabinetOS.Views.TransferFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    Visibility="Collapsed">
    <UserControl.Resources>
        <!-- The design's entrance: 200 ms, sliding up 10 px. -->
        <Storyboard x:Key="Entrance">
            <DoubleAnimation
                Storyboard.TargetName="Panel"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.2" />
            <DoubleAnimation
                Storyboard.TargetName="PanelTransform"
                Storyboard.TargetProperty="TranslateY"
                From="10"
                To="0"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Style
            x:Key="FooterButtonStyle"
            BasedOn="{StaticResource CbSubtleButtonStyle}"
            TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource CbTextPrimaryBrush}" />
            <Setter Property="Background" Value="{ThemeResource CbPillFillBrush}" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
        </Style>
        <Style
            x:Key="CardButtonStyle"
            BasedOn="{StaticResource FooterButtonStyle}"
            TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
    </UserControl.Resources>

    <Border
        x:Name="Panel"
        Width="380"
        Padding="16,14"
        Background="{ThemeResource CbFlyoutAcrylicBrush}"
        BorderBrush="{ThemeResource CbOverlayStrokeBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Border.RenderTransform>
            <CompositeTransform x:Name="PanelTransform" />
        </Border.RenderTransform>
        <StackPanel Spacing="10">
            <!-- Header: title, source → destination, the "N more" link, minimize. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        x:Name="TitleText"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="SubtitleText"
                        FontSize="11"
                        Foreground="{ThemeResource CbTextTertiaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <HyperlinkButton
                    x:Name="MoreLink"
                    Grid.Column="1"
                    Padding="6,2"
                    VerticalAlignment="Top"
                    AllowFocusOnInteraction="False"
                    FontSize="11"
                    Visibility="Collapsed" />
                <Button
                    x:Name="MinimizeButton"
                    Grid.Column="2"
                    Width="26"
                    Height="26"
                    MinWidth="0"
                    VerticalAlignment="Top"
                    AllowFocusOnInteraction="False"
                    AutomationProperties.Name="Minimize to the status bar"
                    Style="{StaticResource CbSubtleButtonStyle}"
                    ToolTipService.ToolTip="Minimize to the status bar">
                    <FontIcon FontSize="10" Glyph="&#xE921;" />
                </Button>
            </Grid>

            <!-- A conflict that waits for a decision; one at a time. -->
            <Border
                x:Name="ConflictCard"
                Padding="12,10"
                Background="{ThemeResource CbCardFillBrush}"
                BorderBrush="{ThemeResource CbOverlayStrokeBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ConflictName"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="ConflictCount"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource CbTextTertiaryBrush}" />
                    </Grid>
                    <TextBlock
                        x:Name="ConflictKindText"
                        FontSize="12"
                        Foreground="{ThemeResource CbErrorTextBrush}"
                        TextWrapping="Wrap" />
                    <Grid
                        x:Name="ConflictSides"
                        ColumnSpacing="10"
                        RowSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource CbTextTertiaryBrush}"
                            Text="New" />
                        <TextBlock
                            x:Name="NewSideText"
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="{ThemeResource CbTextSecondaryBrush}" />
                        <TextBlock
                            Grid.Row="1"
                            FontSize="11"
                            Foreground="{ThemeResource CbTextTertiaryBrush}"
                            Text="Existing" />
                        <TextBlock
                            x:Name="ExistingSideText"
                            Grid.Row="1"
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="{ThemeResource CbTextSecondaryBrush}" />
                    </Grid>
                    <StackPanel
                        x:Name="ConflictButtons"
                        Orientation="Horizontal"
                        Spacing="6" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            x:Name="ApplyToAll"
                            MinHeight="0"
                            Padding="6,0,0,0"
                            AllowFocusOnInteraction="False"
                            Content="Apply to all of this kind"
                            FontSize="12" />
                        <Button
                            x:Name="CancelJobButton"
                            Grid.Column="1"
                            Content="Cancel job"
                            Style="{StaticResource CardButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Speed graph: the last 40 samples, 500 ms apart. -->
            <Grid
                Height="56"
                Background="{ThemeResource CbGraphFillBrush}"
                CornerRadius="6">
                <Canvas x:Name="Graph">
                    <Polygon
                        x:Name="GraphFill"
                        Fill="{ThemeResource CbAccentBrush}"
                        Opacity="0.18" />
                    <Polyline
                        x:Name="GraphLine"
                        Stroke="{ThemeResource CbAccentBrush}"
                        StrokeThickness="1.5" />
                </Canvas>
                <TextBlock
                    x:Name="SpeedText"
                    Margin="0,6,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    FontFamily="{StaticResource CbMonoFont}"
                    FontSize="11"
                    Foreground="{ThemeResource CbTextSecondaryBrush}" />
            </Grid>

            <!-- Progress bar: 4 px, the width follows the core's numbers over 400 ms. -->
            <Grid
                Height="4"
                Background="{ThemeResource CbProgressTrackBrush}"
                CornerRadius="2">
                <Rectangle
                    x:Name="ProgressFill"
                    Fill="{ThemeResource CbAccentBrush}"
                    RadiusX="2"
                    RadiusY="2" />
            </Grid>

            <!-- Footer: percent, done of total, time left, Pause/Resume, Cancel/Close. -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PercentText"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="DoneText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource CbTextSecondaryBrush}" />
                <TextBlock
                    x:Name="EtaText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource CbTextSecondaryBrush}" />
                <Button
                    x:Name="PauseButton"
                    Grid.Column="4"
                    Style="{StaticResource FooterButtonStyle}" />
                <Button
                    x:Name="EndButton"
                    Grid.Column="5"
                    Style="{StaticResource FooterButtonStyle}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
