<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CabinetOS.Views.PluginsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    Visibility="Collapsed">
    <!--
      Like the palette: a transparent scrim (a click closes) and a 640 px Acrylic panel. Tab goes around the panel's own
      buttons and never leaves it while it is open (Cycle), as the palette keeps its keyboard.
    -->
    <Grid x:Name="Scrim" Background="Transparent">
        <Border
            x:Name="Panel"
            Width="640"
            Margin="0,64,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource CbPaletteAcrylicBrush}"
            BorderBrush="{ThemeResource CbOverlayStrokeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            TabFocusNavigation="Cycle"
            Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{ThemeResource CbDividerBrush}" BorderThickness="0,0,0,1">
                    <Grid Padding="16,10,8,10" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource CbTextPrimaryBrush}"
                            Text="Plugins" />
                        <TextBlock
                            x:Name="SummaryText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource CbHintTextBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="CloseButton"
                            Grid.Column="2"
                            AutomationProperties.Name="Close"
                            Style="{StaticResource CbSubtleButtonStyle}"
                            ToolTipService.ToolTip="Close (Esc)">
                            <FontIcon FontSize="10" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer
                    Grid.Row="1"
                    MaxHeight="460"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        x:Name="List"
                        Padding="10"
                        Spacing="8" />
                </ScrollViewer>
                <TextBlock
                    x:Name="EmptyText"
                    Grid.Row="1"
                    Padding="16,20"
                    Foreground="{ThemeResource CbTextTertiaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <Border
                    Grid.Row="2"
                    Padding="16,8"
                    BorderBrush="{ThemeResource CbDividerBrush}"
                    BorderThickness="0,1,0,0">
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource CbHintTextBrush}"
                        Text="Each plugin runs in a WebAssembly sandbox with only what you allowed · Esc to close"
                        TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
