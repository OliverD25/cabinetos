<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CabinetOS.Views.ToolDock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CabinetOS.Views">
    <!--
      The Tool Dock (design view A, "Integrated terminal"): rgba(0,0,0,.35), 8 px radius. The
      default look's sizes; the theme's metrics replace them (ToolDock.ApplyMetrics).
    -->
    <Border
        x:Name="Frame"
        Background="{ThemeResource CbTerminalFillBrush}"
        BorderBrush="{ThemeResource CbTerminalStrokeBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <!--
          The one view: one header over the whole body. The split mirror (ToolDock.ApplySplit): the three columns
          are the left pane's half, the gap between the panes, and the right pane's half, so each half's header sits
          under its pane; the body, one WebView2, spans all three and its page puts a terminal in each half.
        -->
        <Grid x:Name="DockGrid">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FirstColumn" Width="*" />
                <ColumnDefinition x:Name="GapColumn" Width="0" />
                <ColumnDefinition x:Name="SecondColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Header, 34 px: a tab per session (its pane's badge, its mode), "+", the other profiles, the caption, close. -->
            <views:TerminalHalfHeader x:Name="LeftHeader" />
            <views:TerminalHalfHeader
                x:Name="RightHeader"
                Grid.Column="2"
                Visibility="Collapsed" />

            <!-- Body: the terminal page (one WebView2 for every session). -->
            <Grid
                x:Name="Body"
                Grid.Row="1"
                Grid.ColumnSpan="3">
                <Border x:Name="TerminalFrame" />
                <TextBlock
                    x:Name="StartingText"
                    Margin="12,8"
                    FontFamily="{StaticResource CbMonoFont}"
                    FontSize="12"
                    Foreground="{ThemeResource CbHintTextBrush}"
                    Text="Starting the terminal…"
                    Visibility="Collapsed" />
                <!-- When the page's process ends: the window goes on, and Reload brings the page back. -->
                <StackPanel
                    x:Name="StoppedPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="StoppedText"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource CbTextPrimaryBrush}"
                        Text="The terminal stopped" />
                    <TextBlock
                        x:Name="StoppedReason"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbHintTextBrush}" />
                    <Button
                        x:Name="ReloadButton"
                        HorizontalAlignment="Center"
                        Content="Reload" />
                </StackPanel>
            </Grid>

            <!-- The split's divider, in the gap between the panes; it follows them. -->
            <Border
                x:Name="SplitDivider"
                Grid.Column="1"
                Grid.RowSpan="2"
                Width="1"
                HorizontalAlignment="Center"
                Background="{ThemeResource CbDividerBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
