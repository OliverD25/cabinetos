<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CabinetOS.Views.QuickViewPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    Visibility="Collapsed">
    <UserControl.Resources>
        <!-- 120 ms scale-and-fade in; skipped when Windows' animations are off (QuickViewPanel.Open). -->
        <Storyboard x:Key="Entrance">
            <DoubleAnimation
                Storyboard.TargetName="Card"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.12" />
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.96"
                To="1"
                Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.96"
                To="1"
                Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <!--
      No scrim (ADR 0023, W3): the root has no background, so the panes around the card stay visible, do not move and
      take their clicks; a click in the other pane moves the keyboard there, and that closes the panel.
    -->
    <Grid x:Name="Root">
        <Border
            x:Name="Card"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="Quick View"
            Background="{ThemeResource CbPaletteAcrylicBrush}"
            BorderBrush="{ThemeResource CbOverlayStrokeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            RenderTransformOrigin="0.5,0.5"
            Translation="0,0,32">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" />
            </Border.RenderTransform>
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <!-- The top bar: icon, name, "3 of 120", the viewer button (two or more viewers), Open, Close. -->
                <Grid
                    Padding="12,0,6,0"
                    BorderBrush="{ThemeResource CbDividerBrush}"
                    BorderThickness="0,0,0,1"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        x:Name="TitleIcon"
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="TitleText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource CbTextPrimaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="PositionText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource CbHintTextBrush}" />
                    <DropDownButton
                        x:Name="ViewerButton"
                        Grid.Column="3"
                        Height="28"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.Name="Viewer"
                        FontSize="12"
                        IsTabStop="False"
                        Visibility="Collapsed">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="ViewerMenu" Placement="BottomEdgeAlignedRight" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button
                        x:Name="OpenButton"
                        Grid.Column="4"
                        Height="28"
                        Padding="10,0"
                        VerticalAlignment="Center"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.Name="Open"
                        Content="Open"
                        FontSize="12"
                        IsTabStop="False"
                        Style="{StaticResource CbSubtleButtonStyle}"
                        ToolTipService.ToolTip="Open the file in its program (Enter)" />
                    <Button
                        x:Name="CloseButton"
                        Grid.Column="5"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.Name="Close Quick View"
                        IsTabStop="False"
                        Style="{StaticResource CbSubtleButtonStyle}"
                        ToolTipService.ToolTip="Close (Space or Esc)">
                        <FontIcon FontSize="10" Glyph="&#xE8BB;" />
                    </Button>
                </Grid>

                <!-- The content: the icon card, the thumbnail and the viewer's page, one over the other. -->
                <Grid x:Name="ContentArea" Grid.Row="1">
                    <StackPanel
                        x:Name="CardView"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <Image
                            x:Name="CardIcon"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            x:Name="CardName"
                            MaxWidth="420"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource CbTextPrimaryBrush}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="CardType"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource CbTextSecondaryBrush}" />
                        <TextBlock
                            x:Name="CardFacts"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource CbHintTextBrush}" />
                    </StackPanel>
                    <Image
                        x:Name="ThumbnailImage"
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        Visibility="Collapsed" />
                    <!-- Each viewer's WebView2 has a frame of its own here (MainWindow.QuickView.cs). -->
                    <Grid x:Name="PageLayer" />

                    <!-- The line under the thumbnail, and the install offer bar. -->
                    <StackPanel
                        Margin="16,0,16,14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Spacing="6">
                        <TextBlock
                            x:Name="StatusText"
                            MaxWidth="560"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource CbTextSecondaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="OfferBar"
                            Padding="14,10"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource CbCardFillBrush}"
                            BorderBrush="{ThemeResource CbOverlayStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" Spacing="6">
                                <TextBlock
                                    x:Name="OfferText"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource CbTextPrimaryBrush}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="InstallButton"
                                    HorizontalAlignment="Center"
                                    AllowFocusOnInteraction="False"
                                    IsTabStop="False"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="OfferNote"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource CbHintTextBrush}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- The bottom line: size, date, and the viewer's details. -->
                <Border
                    Grid.Row="2"
                    Padding="12,0"
                    BorderBrush="{ThemeResource CbDividerBrush}"
                    BorderThickness="0,1,0,0">
                    <TextBlock
                        x:Name="FactsText"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbHintTextBrush}"
                        TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
