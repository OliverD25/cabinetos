<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CabinetOS.Views.QuickOpen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    Visibility="Collapsed">
    <UserControl.Resources>
        <!-- The command palette's entrance: 160 ms, opacity, 6 px down, scale .98 to 1. -->
        <Storyboard x:Key="Entrance">
            <DoubleAnimation
                Storyboard.TargetName="Panel"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.16" />
            <DoubleAnimation
                Storyboard.TargetName="PanelTransform"
                Storyboard.TargetProperty="TranslateY"
                From="-6"
                To="0"
                Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="PanelTransform"
                Storyboard.TargetProperty="ScaleX"
                From="0.98"
                To="1"
                Duration="0:0:0.16" />
            <DoubleAnimation
                Storyboard.TargetName="PanelTransform"
                Storyboard.TargetProperty="ScaleY"
                From="0.98"
                To="1"
                Duration="0:0:0.16" />
        </Storyboard>
    </UserControl.Resources>

    <!--
      Quick Open (Phase 16, Ctrl+P; docs/ui.md, "Quick Open"): the command palette's surface, listing the workspace's
      files and folders instead of commands. The full-window scrim is transparent; a click on it closes Quick Open.
    -->
    <Grid x:Name="Scrim" Background="Transparent">
        <Border
            x:Name="Panel"
            Width="640"
            Margin="0,64,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource CbPaletteAcrylicBrush}"
            BorderBrush="{ThemeResource CbOverlayStrokeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            RenderTransformOrigin="0.5,0"
            Translation="0,0,32">
            <Border.RenderTransform>
                <CompositeTransform x:Name="PanelTransform" />
            </Border.RenderTransform>
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="12,10,12,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Height="34"
                        Padding="10,0"
                        Background="{ThemeResource CbPaletteInputFillBrush}"
                        BorderBrush="{StaticResource CbPaletteInputAccentBrush}"
                        BorderThickness="1,1,1,2"
                        CornerRadius="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource CbTextTertiaryBrush}"
                                Glyph="&#xE721;" />
                            <TextBox
                                x:Name="Input"
                                Grid.Column="1"
                                MinHeight="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Quick Open"
                                Background="Transparent"
                                BorderThickness="0"
                                PlaceholderText="Search files by name (type &gt; for commands)">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                    </Border>
                    <TextBlock
                        x:Name="CountText"
                        Grid.Column="1"
                        MaxWidth="200"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        FontSize="11"
                        Foreground="{ThemeResource CbHintTextBrush}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <ScrollViewer
                    x:Name="ListScroller"
                    Grid.Row="1"
                    MaxHeight="400"
                    Padding="6,0,6,8"
                    HorizontalScrollMode="Disabled"
                    IsTabStop="False"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="List" />
                </ScrollViewer>

                <Border
                    Grid.Row="2"
                    BorderBrush="{ThemeResource CbDividerBrush}"
                    BorderThickness="0,1,0,0">
                    <StackPanel
                        Padding="14,6,14,8"
                        Orientation="Horizontal"
                        Spacing="16">
                        <TextBlock FontSize="11" Foreground="{ThemeResource CbHintTextBrush}" Text="↑↓ navigate" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource CbHintTextBrush}" Text="↵ open in this pane" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource CbHintTextBrush}" Text="Ctrl+↵ open in the other pane" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource CbHintTextBrush}" Text="&gt; commands" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
