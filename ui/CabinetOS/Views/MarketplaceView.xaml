<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CabinetOS.Views.MarketplaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CabinetOS.Views"
    IsTabStop="False"
    Visibility="Collapsed">
    <UserControl.Resources>
        <!-- The detail column slides in: 180 ms, opacity and 12 px from the right. -->
        <Storyboard x:Key="DetailEntrance">
            <DoubleAnimation
                Storyboard.TargetName="Detail"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.18" />
            <DoubleAnimation
                Storyboard.TargetName="DetailTransform"
                Storyboard.TargetProperty="TranslateX"
                From="12"
                To="0"
                Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- A card: 14 px padding, 8 px radius, the card fill; hover lighter; the stroke says whether it is selected. -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CbCardFillBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource CbTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CbDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource CbHoverFillBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource CbPressedFillBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A secondary button of the detail column: the design's .06 fill and 1 px stroke. -->
        <Style x:Key="DetailButtonStyle" BasedOn="{StaticResource CbSubtleButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CbHoverFillBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource CbTextPrimaryBrush}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <!-- Design view C: a Layer surface in place of the main column. -->
    <Border
        Background="{ThemeResource CbLayerFillBrush}"
        BorderBrush="{ThemeResource CbLayerStrokeBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The nav, 180 px: the heading and one row per tab with its count. -->
            <Border
                Padding="6,12"
                BorderBrush="{ThemeResource CbDividerBrush}"
                BorderThickness="0,0,1,0">
                <StackPanel Spacing="2">
                    <TextBlock
                        Margin="10,4,10,10"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource CbTextPrimaryBrush}"
                        Text="Marketplace" />
                    <StackPanel x:Name="NavRows" Spacing="2" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The toolbar: the search field (at most 420 px), the caption, and Refresh. -->
                <Grid Padding="18,14,14,6" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="420" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="SearchField"
                        Height="32"
                        AutomationProperties.Name="Search plugins and themes"
                        PlaceholderText="Search plugins and themes" />
                    <TextBlock
                        x:Name="CaptionText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource CbStatusTextBrush}" />
                    <Button
                        x:Name="RefreshButton"
                        Grid.Column="3"
                        AutomationProperties.Name="Read the index again"
                        Style="{StaticResource CbSubtleButtonStyle}"
                        ToolTipService.ToolTip="Read the index again">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                </Grid>

                <ScrollViewer
                    x:Name="CardScroller"
                    Grid.Row="1"
                    Padding="18,8,18,18"
                    HorizontalScrollMode="Disabled"
                    IsTabStop="False"
                    VerticalScrollBarVisibility="Auto">
                    <local:CardGrid
                        x:Name="Cards"
                        MinItemWidth="230"
                        Spacing="10" />
                </ScrollViewer>

                <!-- What happened instead of cards: no index, an error, nothing found. -->
                <StackPanel
                    x:Name="NoticePanel"
                    Grid.Row="1"
                    MaxWidth="460"
                    Margin="18,48,18,18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Spacing="6"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="NoticeTitle"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource CbTextPrimaryBrush}"
                        HorizontalTextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="NoticeDetail"
                        FontSize="12"
                        Foreground="{ThemeResource CbStatusTextBrush}"
                        HorizontalTextAlignment="Center"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- The detail column, 340 px, for the selected card. -->
            <Border
                x:Name="Detail"
                Grid.Column="2"
                Width="340"
                BorderBrush="{ThemeResource CbDividerBrush}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="DetailTransform" />
                </Border.RenderTransform>
                <ScrollViewer HorizontalScrollMode="Disabled" IsTabStop="False">
                    <StackPanel>
                        <StackPanel Padding="18,18,18,12" Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="DetailTile"
                                    Width="52"
                                    Height="52"
                                    CornerRadius="10">
                                    <TextBlock
                                        x:Name="DetailTileText"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource CbOnAccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="DetailName"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource CbTextPrimaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="DetailByline"
                                        FontSize="12"
                                        Foreground="{ThemeResource CbStatusTextBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button
                                    x:Name="CloseDetailButton"
                                    Grid.Column="2"
                                    Width="26"
                                    Height="26"
                                    MinWidth="26"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="Close the details"
                                    Style="{StaticResource CbSubtleButtonStyle}"
                                    ToolTipService.ToolTip="Close (Esc)">
                                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- The primary button; while installing, a thin bar under its words shows the download. -->
                                <Grid>
                                    <Button
                                        x:Name="PrimaryButton"
                                        Height="32"
                                        MinWidth="96"
                                        Padding="18,0"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource AccentButtonStyle}">
                                        <Button.Resources>
                                            <!-- "Installed" and "Applied": the design's .06 fill and .7 text, not WinUI's disabled accent. -->
                                            <StaticResource x:Key="AccentButtonBackgroundDisabled" ResourceKey="CbHoverFillBrush" />
                                            <StaticResource x:Key="AccentButtonForegroundDisabled" ResourceKey="CbPaneTitleInactiveBrush" />
                                            <StaticResource x:Key="AccentButtonBorderBrushDisabled" ResourceKey="CbDividerBrush" />
                                        </Button.Resources>
                                        <TextBlock x:Name="PrimaryText" />
                                    </Button>
                                    <Rectangle
                                        x:Name="ProgressBar"
                                        Height="2"
                                        Margin="6,0,6,4"
                                        VerticalAlignment="Bottom"
                                        Fill="{ThemeResource CbAccentBrush}"
                                        IsHitTestVisible="False"
                                        RadiusX="1"
                                        RadiusY="1"
                                        RenderTransformOrigin="0,0.5"
                                        Visibility="Collapsed">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                                <Button
                                    x:Name="SourceButton"
                                    Content="Source"
                                    Style="{StaticResource DetailButtonStyle}" />
                                <Button
                                    x:Name="UninstallButton"
                                    Content="Uninstall"
                                    Style="{StaticResource DetailButtonStyle}"
                                    Visibility="Collapsed" />
                            </StackPanel>

                            <TextBlock
                                x:Name="DetailError"
                                FontSize="12"
                                Foreground="{ThemeResource CbErrorTextBrush}"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />

                            <!-- Three stat tiles: rating, installs, size. -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Padding="10,8"
                                    Background="{ThemeResource CbCardFillBrush}"
                                    CornerRadius="6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock
                                                x:Name="RatingValue"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource CbTextPrimaryBrush}" />
                                            <TextBlock
                                                x:Name="RatingStar"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource CbRatingStarBrush}"
                                                Text="★" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="RatingLabel"
                                            FontSize="11"
                                            Foreground="{ThemeResource CbStatusTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Padding="10,8"
                                    Background="{ThemeResource CbCardFillBrush}"
                                    CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock
                                            x:Name="InstallsValue"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource CbTextPrimaryBrush}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource CbStatusTextBrush}"
                                            Text="installs" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Grid.Column="2"
                                    Padding="10,8"
                                    Background="{ThemeResource CbCardFillBrush}"
                                    CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock
                                            x:Name="SizeValue"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource CbTextPrimaryBrush}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource CbStatusTextBrush}"
                                            Text="download" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock
                                x:Name="LongText"
                                FontSize="13"
                                Foreground="{ThemeResource CbDialogTextBrush}"
                                IsTextSelectionEnabled="True"
                                LineHeight="20"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- What a plugin asks for: level dot, name, reason. -->
                        <StackPanel
                            x:Name="CapabilitiesSection"
                            Padding="18,6,18,18"
                            Spacing="8">
                            <TextBlock Style="{StaticResource CbSectionLabelStyle}" Text="REQUESTED CAPABILITIES" />
                            <StackPanel x:Name="CapabilityRows" Spacing="8" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
