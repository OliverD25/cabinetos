<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CabinetOS.Views.EditorPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    Visibility="Collapsed">
    <!--
      A pane's editor (design view D): a 36 px tab strip over a Tool Extension's page. The
      default look's sizes; the theme's metrics replace them (EditorPane.ApplyMetrics).
    -->
    <Border
        x:Name="Surface"
        Background="{ThemeResource CbLayerFillBrush}"
        BorderBrush="{ThemeResource CbLayerStrokeBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TabStripRow" Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="TabStrip"
                BorderBrush="{ThemeResource CbDividerBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The tab: a 2 px accent top edge, the file's glyph and name, and close. -->
                    <Grid
                        x:Name="TabCell"
                        Background="{ThemeResource CbLayerFillBrush}"
                        BorderBrush="{ThemeResource CbDividerBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="8,0,0,0">
                        <Rectangle
                            Height="2"
                            VerticalAlignment="Top"
                            Fill="{ThemeResource CbAccentBrush}" />
                        <StackPanel
                            Padding="14,0,6,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                x:Name="FileIcon"
                                FontSize="14"
                                Glyph="&#xE8A5;" />
                            <TextBlock
                                x:Name="FileNameText"
                                MaxWidth="260"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource CbTextPrimaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="CloseButton"
                                Width="20"
                                Height="20"
                                MinWidth="20"
                                Margin="4,0,0,0"
                                Padding="0"
                                AllowFocusOnInteraction="False"
                                AutomationProperties.Name="Close"
                                IsTabStop="False"
                                Style="{StaticResource CbDockTabButtonStyle}"
                                ToolTipService.ToolTip="Close: back to the folder">
                                <FontIcon FontSize="8" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- The tool's name with a green dot, and Open in Terminal. -->
                    <StackPanel
                        Grid.Column="2"
                        Padding="0,0,8,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <StackPanel
                            Padding="6,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Ellipse
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{StaticResource CbRunningBrush}" />
                            <TextBlock
                                x:Name="ProviderText"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource CbHintTextBrush}" />
                        </StackPanel>
                        <Button
                            x:Name="TerminalButton"
                            Height="26"
                            Padding="10,0"
                            AllowFocusOnInteraction="False"
                            Background="{ThemeResource CbPillFillBrush}"
                            Content="Open in Terminal"
                            FontSize="12"
                            IsTabStop="False"
                            Style="{StaticResource CbDockTabButtonStyle}"
                            ToolTipService.ToolTip="A shell in this file's folder" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Border x:Name="ToolFrame" CornerRadius="0,0,8,8" />
                <!--
                  While rows of a pane are dragged, this lies over the page: a WebView2 takes drops for itself,
                  so the window catches them here and tells the page (paths-dropped, docs/tool-extensions.md).
                -->
                <Border
                    x:Name="DropCatcher"
                    AllowDrop="True"
                    Background="Transparent"
                    BorderBrush="{ThemeResource CbAccentBrush}"
                    BorderThickness="0"
                    CornerRadius="0,0,8,8"
                    Visibility="Collapsed" />
                <!-- When the tool's process ends: the window goes on, and Reload brings the page back. -->
                <StackPanel
                    x:Name="StoppedPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource CbTextPrimaryBrush}"
                        Text="The tool stopped" />
                    <TextBlock
                        x:Name="StoppedReason"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CbHintTextBrush}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="ReloadButton"
                        HorizontalAlignment="Center"
                        Content="Reload" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
