<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything the window needs that can be tested without a window: the
       pipe client, the protocol, the shared-memory reader, keys and chords,
       the command router and diagnostics. -->
  <PropertyGroup>
    <RootNamespace>CabinetOS.Core</RootNamespace>
    <!-- For the shared-memory reader (ListingView) and CsWin32's generated code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CabinetOS.Tests" />
  </ItemGroup>
</Project>
